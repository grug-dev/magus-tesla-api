  "cards": [
    {
      "dot": "cyan",
      "title": "Read path — 99% of DB ops",
      "items": [
        "Browser → Caddy → Gin gateway → read ports → PostgreSQL",
        "Gateway renders Templ fragments; it has zero DB access",
        "Dashboards read pre-aggregated summaries, never raw tables"
      ]
    },
    {
      "dot": "emerald",
      "title": "Nightly write path — 1% of DB ops",
      "items": [
        "One batch at 03:30 local (America/Bogota), all accounts",
        "CollectAll → Tesla adapter → INSERT raw JSONB + typed columns",
        "Charging verifies sessions; analytics recalculates metrics"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust & module boundaries",
      "items": [
        "Caddy is the only public service; PostgreSQL binds to 127.0.0.1",
        "Users never trigger Tesla calls — the nightly batch is the exception",
        "One-way deps: gateway → modules → adapters; no import cycles"
      ]
    }
  ]
