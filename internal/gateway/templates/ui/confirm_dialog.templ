package ui

import "github.com/cristianpena/magus-tesla-api/internal/gateway/i18n"

// ConfirmDialog is the app's ONE confirmation modal. It is rendered a single time
// per page by layouts.Base — never per row, never per page — and is driven entirely
// by the htmx `hx-confirm` attribute already on the triggering element.
//
// How to use it (this is the whole API — no Go call, no new markup):
//
//	@ui.Button(ui.ButtonProps{
//	    Variant: "error",
//	    Attrs: templ.Attributes{
//	        "hx-delete":            "/ui/thing/" + id,
//	        "hx-confirm":           "Delete the March invoice? This cannot be undone.",
//	        "data-confirm-title":   "Delete invoice",   // optional, default "Are you sure?"
//	        "data-confirm-label":   "Delete",           // optional, default "Confirm"/"Delete"
//	        "data-confirm-variant": "danger",           // optional, "danger" = red confirm button
//	    },
//	}) { Delete }
//
// static/app.js intercepts htmx's cancelable `htmx:confirm` event, fills this
// dialog from those attributes, and calls `issueRequest(true)` when the user
// confirms. So ANY element on ANY page that carries `hx-confirm` gets this modal
// instead of the browser's native window.confirm() — including elements that do
// not exist yet. Adding a confirmation elsewhere means adding `hx-confirm`, and
// nothing else.
//
// Deliberate exception to the "no component that needs client-side JS init" rule in
// ai/htmx-conventions.md: replacing window.confirm() is inherently a JS-interception
// job — htmx only offers the hook as an event, and a CSS-only (checkbox/anchor)
// modal cannot gate an in-flight htmx request at all. The JS is ~40 lines, lives in
// the single shared app.js, and is wired to htmx's own documented event rather than
// to any per-page markup. Native <dialog>.showModal() is used so focus-trapping,
// Esc-to-close, inertness of the page behind, and the top-layer stacking are the
// browser's job, not ours.
//
// Two confirm buttons are pre-rendered (default + danger) and app.js unhides one.
// That keeps every DaisyUI `btn-*` class inside this ui/ adapter — app.js only ever
// toggles the `hidden` property and sets textContent, never a class string.
templ ConfirmDialog() {
	<dialog id="confirm-dialog" class="modal" aria-labelledby="confirm-dialog-title">
		<div class="modal-box">
			<h3 id="confirm-dialog-title" class="text-lg font-semibold">{ i18n.T(ctx, i18n.KeyConfirmDialogTitle) }</h3>
			<p id="confirm-dialog-message" class="py-4 text-base-content/80"></p>
			<div class="modal-action">
				@Button(ButtonProps{Variant: "ghost", Attrs: templ.Attributes{"id": "confirm-dialog-cancel"}}) {
					{ i18n.T(ctx, i18n.KeyConfirmDialogCancel) }
				}
				@Button(ButtonProps{Variant: "primary", Attrs: templ.Attributes{"data-confirm-ok": "default"}}) {
					{ i18n.T(ctx, i18n.KeyConfirmDialogConfirm) }
				}
				@Button(ButtonProps{Variant: "error", Attrs: templ.Attributes{"data-confirm-ok": "danger", "hidden": true}}) {
					{ i18n.T(ctx, i18n.KeyConfirmDialogDelete) }
				}
			</div>
		</div>
		// Native backdrop close: a <form method="dialog"> submit closes the dialog
		// without JS, so click-outside-to-dismiss costs nothing.
		<form method="dialog" class="modal-backdrop">
			<button aria-label={ i18n.T(ctx, i18n.KeyConfirmDialogClose) }>{ i18n.T(ctx, i18n.KeyConfirmDialogClose) }</button>
		</form>
	</dialog>
}
