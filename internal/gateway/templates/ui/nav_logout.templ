package ui

import "github.com/cristianpena/magus-tesla-api/internal/gateway/i18n"

// NavLogout renders the bottom-of-sidebar logout form. It is passed as NavShell's
// footer slot so the logout control lives at the bottom of the menu while the
// `menu` component class stays owned by NavShell. The form POSTs to /logout
// (BaseAuth/Base are full-page shells, so a full-page redirect is correct — no
// htmx partial here; the session clears and the browser lands on /login).
//
// Uses semantic tokens only (text-error-400 for the logout word, ghost hover)
// so it re-skins with <html data-theme>; never a hex color, never a raw DaisyUI
// class — the wrapper composition keeps the kit boundary intact.
templ NavLogout() {
	<form method="post" action="/logout" class="w-full">
		<button type="submit" class="flex items-center gap-2 text-left w-full">
			<span>
				@Icon(IconProps{Name: "logout", Class: "h-5 w-5"})
			</span>
			<span>{ i18n.T(ctx, i18n.KeyNavLogout) }</span>
		</button>
	</form>
}