package ui

// GoogleSignInButtonProps configures a GoogleSignInButton. Label is user-facing and
// resolves through i18n.T at the call site (KeyLoginContinueGoogle).
type GoogleSignInButtonProps struct {
	Label string
	Size  string // passed to ui.Button: "lg" on the landing page, "" on /login
	Class string // extra layout utilities only
}

// GoogleSignInButton is the one "Continue with Google" link, wired to the existing
// OAuth start route. /login and the landing page both render it, so the route and
// the logo live in one place.
//
// The Google "G" brand fills (#4285F4 / #34A853 / #FBBC05 / #EA4335) are the ONE
// permitted hardcoded-colour exception in the gateway's markup: a third-party logo's
// official brand colours, not the app palette. Keeping the logo here, and nowhere
// else, keeps that exception to a single file.
templ GoogleSignInButton(p GoogleSignInButtonProps) {
	@Button(ButtonProps{Variant: "primary", Size: p.Size, Href: "/auth/google/login", Class: p.Class}) {
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 48 48" aria-hidden="true">
			<path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.84 6.56-9.5 6.56-16.17z"></path>
			<path fill="#34A853" d="M24 46c5.92 0 10.9-1.96 14.53-5.32l-7.11-5.52c-1.97 1.32-4.49 2.1-7.42 2.1-5.7 0-10.52-3.84-12.24-9.01H4.5v5.7C8.11 41.07 15.48 46 24 46z"></path>
			<path fill="#FBBC05" d="M11.76 28.25c-.44-1.32-.69-2.73-.69-4.25s.25-2.93.69-4.25v-5.7H4.5C3.06 16.81 2 20.28 2 24s1.06 7.19 2.5 9.95l7.26-5.7z"></path>
			<path fill="#EA4335" d="M24 10.75c3.22 0 6.1 1.11 8.38 3.29l6.26-6.26C34.9 4.18 29.92 2 24 2 15.48 2 8.11 6.93 4.5 14.05l7.26 5.7c1.72-5.17 6.54-9.01 12.24-9.01z"></path>
		</svg>
		{ p.Label }
	}
}
