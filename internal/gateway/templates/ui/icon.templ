package ui

// IconProps configures an Icon. Name is a closed glyph vocabulary (extended in the
// switch in iconMarkup below); Class is extra layout utilities (e.g. "h-5 w-5") —
// never a color class, since the SVG uses fill="currentColor" driven by the
// surrounding text color semantic token (text-base-content / text-primary / …).
type IconProps struct {
	Name  string // "dashboard"|"ev_station"|"analytics"|"settings"|"menu"|"battery"|"logout"|"car"|"globe"|"speed"|"groups"
	Class string
}

// Icon renders an inline SVG glyph from a closed vocabulary. No external CDN, no
// icon-font webfont, no client-side JS — only inline SVG with fill="currentColor"
// so semantic theme tokens drive its color and the whole app re-skins from one
// <html data-theme>. Add a glyph by extending the switch in iconMarkup (one place).
templ Icon(p IconProps) {
	@iconMarkup(p)
}

// iconMarkup maps a glyph name to its inline SVG path data. A closed vocabulary so
// an agent looks up the name instead of re-drawing SVG — AI-efficiency + the
// ui.Icon abstraction means a glyph can be refined here without touching pages.
templ iconMarkup(p IconProps) {
	switch p.Name {
	case "menu":
		<svg xmlns="http://www.w3.org/2000/svg" class={ p.Class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M3 6h18v2H3zM3 11h18v2H3zM3 16h18v2H3z"/>
		</svg>
	case "dashboard":
		<svg xmlns="http://www.w3.org/2000/svg" class={ p.Class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M3 3h8v8H3zM13 3h8v8h-8zM3 13h8v8H3zM13 13h8v8h-8z"/>
		</svg>
	case "ev_station":
		<svg xmlns="http://www.w3.org/2000/svg" class={ p.Class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M7 2v11h3v9l7-12h-4l4-8z"/>
		</svg>
	case "analytics":
		<svg xmlns="http://www.w3.org/2000/svg" class={ p.Class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M4 20V10h3v10zm6 0V4h3v16zm6 0v-7h3v7z"/>
		</svg>
	case "settings":
		<svg xmlns="http://www.w3.org/2000/svg" class={ p.Class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
		</svg>
	case "battery":
		<svg xmlns="http://www.w3.org/2000/svg" class={ p.Class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<rect x="2" y="7" width="17" height="10" rx="2"/>
			<rect x="20" y="10" width="2" height="4"/>
		</svg>
	case "logout":
		<svg xmlns="http://www.w3.org/2000/svg" class={ p.Class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
		</svg>
	case "car":
		<svg xmlns="http://www.w3.org/2000/svg" class={ p.Class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M5 11l1.5-4.5A2 2 0 0 1 8.4 5h7.2a2 2 0 0 1 1.9 1.5L19 11h1a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-1v1a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-1H8v1a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-1H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1zm0 2h14v2H5zm2.5-4.5L7 9h10l-.5-.5A.5.5 0 0 0 16 8H8a.5.5 0 0 0-.5.5zM6.5 15a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm11 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
		</svg>
	case "globe":
		<svg xmlns="http://www.w3.org/2000/svg" class={ p.Class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.91 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2 0 .68.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2 0-.68.07-1.35.16-2h4.68c.09.65.16 1.32.16 2 0 .68-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2 0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/>
		</svg>
	case "speed":
		<svg xmlns="http://www.w3.org/2000/svg" class={ p.Class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M20.38 8.57l-1.23 1.85a8 8 0 0 1-.22 7.58H5.07A8 8 0 0 1 15.58 6.85l1.85-1.23A10 10 0 0 0 3.35 19a2 2 0 0 0 1.72 1h13.85a2 2 0 0 0 1.74-1 10 10 0 0 0-.27-10.43zm-9.79 6.84a2 2 0 0 0 2.83 0l5.66-8.49-8.49 5.66a2 2 0 0 0 0 2.83z"/>
		</svg>
	case "groups":
		<svg xmlns="http://www.w3.org/2000/svg" class={ p.Class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M12 12.75c1.63 0 3.07.39 4.24.9 1.08.5 1.76 1.49 1.76 2.73V18h-12v-1.61c0-1.24.68-2.23 1.76-2.73 1.17-.51 2.61-.91 4.24-.91zM4 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm1.13 1.1c-.37-.06-.74-.1-1.13-.1-.99 0-1.93.21-2.78.58C.48 14.9 0 15.62 0 16.43V18h4.5v-1.61c0-.83.23-1.61.63-2.29zM20 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm4 3.43c0-.81-.48-1.53-1.22-1.85-.85-.37-1.79-.58-2.78-.58-.39 0-.76.04-1.13.1.4.68.63 1.46.63 2.29V18H24v-1.57zM12 9c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3z"/>
		</svg>
	default:
		// Unknown glyph: render nothing (closed-vocabulary contract — pages pass a
		// known name; a typo degrades to blank rather than a broken glyph).
	}
}