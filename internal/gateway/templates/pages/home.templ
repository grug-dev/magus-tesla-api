package pages

import (
	"github.com/cristianpena/magus-tesla-api/internal/gateway/i18n"
	"github.com/cristianpena/magus-tesla-api/internal/gateway/templates/layouts"
)

// HomeView is the landing page's presentation model.
type HomeView struct {
	SignedIn bool
	Email    string
}

// Home is the landing page. It reflects auth state: a sign-in link when anonymous,
// the account email plus dashboard/connect/log-out links when signed in.
templ Home(vm HomeView) {
	@layouts.Base(i18n.T(ctx, i18n.KeyBrandMagus)) {
		<main>
			<h1>{ i18n.T(ctx, i18n.KeyBrandMagus) }</h1>
			if vm.SignedIn {
				<p>{ i18n.T(ctx, i18n.KeyHomeSignedInAs) } <strong>{ vm.Email }</strong>.</p>
				<p><a href="/dashboard">{ i18n.T(ctx, i18n.KeyHomeViewVehicles) }</a></p>
				<p><a href="/connect/tesla">{ i18n.T(ctx, i18n.KeyNavHeaderConnectLink) }</a></p>
				<form method="post" action="/logout">
					<button type="submit">{ i18n.T(ctx, i18n.KeyNavLogout) }</button>
				</form>
			} else {
				<p><a href="/login">{ i18n.T(ctx, i18n.KeyHomeSignInGoogle) }</a></p>
			}
		</main>
	}
}