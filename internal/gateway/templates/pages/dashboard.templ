package pages

import (
	"fmt"

	"github.com/cristianpena/magus-tesla-api/internal/gateway/i18n"
	"github.com/cristianpena/magus-tesla-api/internal/gateway/templates/fragments"
	"github.com/cristianpena/magus-tesla-api/internal/gateway/templates/layouts"
	"github.com/cristianpena/magus-tesla-api/internal/gateway/templates/ui"
)

// Dashboard renders the single-vehicle dashboard for the SELECTED vehicle, mirroring
// the Stitch "Dashboard - Read-Only Metric Monitor" screen within the gateway's
// DaisyUI/Tailwind conventions: a 12-col bento grid — an 8-col "Vehicle Status" hero
// with a mini-stat grid, and a 4-col vital-stats column with a battery card plus the
// history charts region. The shell (top nav + left sidebar) comes from
// layouts.BaseAuth; chrome comes from the owned ui/ kit (PageHeader, Card, StatTile,
// Badge, Button, Alert, Icon) — semantic theme tokens only, never a hex/class soup.
// The #dashboard-history region self-loads via hx-trigger="load" (GET
// /ui/dashboard/history) to render the odometer km/day and battery % bar charts
// (RM5 tier 2). All values are pre-computed display strings on fragments.DashboardData.
templ Dashboard(d fragments.DashboardData) {
	@layouts.BaseAuth(fmt.Sprintf(i18n.T(ctx, i18n.KeyBrandPageTitle), i18n.T(ctx, i18n.KeyNavDashboard)), "/dashboard") {
		<div id="dashboard-content" hx-get="/ui/dashboard" hx-trigger="vehicle-changed from:body" hx-swap="innerHTML">
			@templ.Fragment("dashboard") {
				@ui.PageHeader(ui.PageHeaderProps{Title: i18n.T(ctx, i18n.KeyNavDashboard), Subtitle: d.VehicleName})
				if d.NeedsConnect {
				// The card's own Title/Desc replace the loose <p> that used to sit here.
				// That paragraph WAS the section's description, just written by hand and
				// styled inline — exactly what AGENTS.md §"Every section is titled and
				// described" centralises. Nothing is lost: the title carries the old
				// sentence and the description adds what connecting actually gets you.
				@ui.Card(ui.CardProps{Title: i18n.T(ctx, i18n.KeyDashboardConnectTitle), Desc: i18n.T(ctx, i18n.KeyDashboardConnectDesc), ID: "connect-cta"}) {
						@ui.Button(ui.ButtonProps{Variant: "primary", Href: "/connect/tesla"}) {
							{ i18n.T(ctx, i18n.KeyNavHeaderConnectLink) }
						}
					}
				} else {
					if d.TelemetryUnavailable {
						@ui.Alert(ui.AlertProps{Kind: "warning", Class: "mb-4"}) {
							{ d.Notice }
						}
					}
					<div class="grid grid-cols-1 md:grid-cols-12 gap-6">
						// Hero — Vehicle Status (col-span-8 on desktop).
						<div class="md:col-span-8">
							@ui.Card(ui.CardProps{Title: i18n.T(ctx, i18n.KeyDashboardVehicleStatusTitle), TitleSuffix: dashSubtitle(ctx, d), ID: "vehicle-status", Class: "h-full"}) {
								<div class="flex items-center justify-end">
									<div class="flex items-center gap-2">
										if d.HasSnapshot && d.IsStale {
											@ui.Badge(ui.BadgeProps{Kind: "warning", Text: i18n.T(ctx, i18n.KeyDashboardStaleBadge)})
										}
										if lockedText, lockedKind, showLocked := dashLockedBadge(ctx, d.Locked); showLocked {
											@ui.Badge(ui.BadgeProps{Kind: lockedKind, Text: lockedText})
										}
										if sentryText, sentryKind, showSentry := dashSentryBadge(ctx, d.SentryMode); showSentry {
											@ui.Badge(ui.BadgeProps{Kind: sentryKind, Text: sentryText})
										}
									</div>
								</div>
							// Inner 12-col split: left column is the image + the two lifetime
							// stats (Odometer, MaxRangeCharges); right column holds the named
							// subsections (RM50-gateway-add-travel-progress-subsection D1,
							// roadmap RD9 Option B). Below `md` both collapse to one column, and
							// DOM order already puts the image + lifetime tiles first, then the
							// subsections in order — no order utility needed (R1: CSS-only
							// responsiveness). `md:`, not this module's default `sm:`, matches
							// the outer bento grid this card already sits inside (design.md D1).
							<div class="grid grid-cols-1 md:grid-cols-12 gap-6">
								<div class="md:col-span-4 flex flex-col items-center gap-4">
									<img src={ d.VehicleImage } alt={ d.VehicleName } class="w-full max-w-[220px] object-contain"/>
									<div class="w-full flex flex-col gap-3">
										@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyDashboardOdometer), Value: dashStat(d.HasSnapshot, d.Odometer)})
										@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyDashboardMaxRangeCharges), Value: dashStat(d.HasSnapshot, d.MaxRangeCharges)})
									</div>
								</div>
								<div class="md:col-span-8 flex flex-col gap-6">
									<section id="travel-progress">
										@ui.SectionHeader(ui.SectionHeaderProps{Title: i18n.T(ctx, i18n.KeyDashboardTravelProgressTitle), Desc: i18n.T(ctx, i18n.KeyDashboardTravelProgressDesc)})
										<div class="grid grid-cols-2 gap-3">
											@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyDashboardDistanceTraveled), Value: dashStat(d.HasSnapshot, d.DistanceTraveled), Trend: "up"})
											@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyDashboardBatteryUsed), Value: dashStat(d.HasSnapshot, d.BatteryUsed), Trend: "down"})
											@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyDashboardEfficiency), Value: dashStat(d.HasSnapshot, d.Efficiency)})
										</div>
									</section>
									<section id="tire-pressure">
										@ui.SectionHeader(ui.SectionHeaderProps{Title: i18n.T(ctx, i18n.KeyDashboardTirePressureTitle), Desc: i18n.T(ctx, i18n.KeyDashboardTirePressureDesc)})
										<div class="grid grid-cols-2 gap-3">
											@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyDashboardTireFL), Value: dashStat(d.HasSnapshot, d.TirePressureFL.Value), Trend: d.TirePressureFL.Trend, Desc: d.TirePressureFL.Delta})
											@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyDashboardTireFR), Value: dashStat(d.HasSnapshot, d.TirePressureFR.Value), Trend: d.TirePressureFR.Trend, Desc: d.TirePressureFR.Delta})
											@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyDashboardTireRL), Value: dashStat(d.HasSnapshot, d.TirePressureRL.Value), Trend: d.TirePressureRL.Trend, Desc: d.TirePressureRL.Delta})
											@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyDashboardTireRR), Value: dashStat(d.HasSnapshot, d.TirePressureRR.Value), Trend: d.TirePressureRR.Trend, Desc: d.TirePressureRR.Delta})
										</div>
									</section>
									<section id="interior-exterior">
										@ui.SectionHeader(ui.SectionHeaderProps{Title: i18n.T(ctx, i18n.KeyDashboardInteriorExteriorTitle), Desc: i18n.T(ctx, i18n.KeyDashboardInteriorExteriorDesc)})
										<div class="grid grid-cols-2 gap-3">
											@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyDashboardInterior), Value: dashStat(d.HasSnapshot, d.InsideTemp)})
											@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyDashboardExterior), Value: dashStat(d.HasSnapshot, d.OutsideTemp)})
										</div>
									</section>
								</div>
							</div>
								if d.HasSnapshot && d.LastUpdated != "" {
									<p class="text-xs text-base-content/50 mt-4">{ i18n.T(ctx, i18n.KeyDashboardLastUpdated) } { d.LastUpdated }</p>
								}
							}
						</div>
						// Vital-stats column (col-span-4 on desktop).
					<div id="vital-stats" class="md:col-span-4 flex flex-col gap-6">
						@ui.Card(ui.CardProps{Title: i18n.T(ctx, i18n.KeyDashboardBatteryTitle), ID: "battery-info"}) {
							<div class="flex items-end justify-between mb-4">
								<span class={ "text-4xl font-extrabold", dashBatteryColorClass(d) }>{ dashStat(d.HasSnapshot, d.Battery) }</span>
								@ui.Icon(ui.IconProps{Name: "battery", Class: "h-8 w-8 text-primary/60"})
							</div>
							@ui.Progress(ui.ProgressProps{Value: dashPctAttr(d), Max: 100, Class: "w-full " + dashBatteryColorClass(d)})
								<div class="flex justify-between mt-3 text-sm text-base-content/70">
									<span>{ i18n.T(ctx, i18n.KeyDashboardRangePrefix) } { dashStat(d.HasSnapshot, d.RangeNow) }</span>
									<span>{ dashChargeLimit(d) }</span>
								</div>
							}
							// History region: self-loads on first render via hx-trigger="load"
							// and inherits vehicle-changed re-renders because it lives inside
							// #dashboard-content (htmx-conventions.md §"Cross-region refresh").
							// hx-swap="innerHTML" keeps this wrapper element (and its hx-trigger)
							// in the DOM across selector clicks.
							// i18n:allow: htmx attribute values (hx-trigger/hx-swap), not a text node
							<div id="dashboard-history" hx-get={ d.DefaultHistoryHref } hx-trigger="load" hx-swap="innerHTML"></div>
						</div>
					</div>
				}
			}
		</div>
	}
}

