package fragments

import (
	"fmt"

	"github.com/cristianpena/magus-tesla-api/internal/gateway/i18n"
	"github.com/cristianpena/magus-tesla-api/internal/gateway/templates/ui"
)

// SuperchargerRow renders the static view of one Supercharger session as a
// table row. Its id="supercharger-row-{vm.ID}" matches the templ.Fragment id
// pattern and is the target for the inline-edit swap — mirrors ExternalChargeRow
// (external_charge_row.templ).
//
// windowStartStr/windowEndStr are the SAME ?start=&end= window the table was
// rendered under (design.md D2, RM31-gateway-add-session-battery-edit) —
// threaded here (rather than through SuperchargerStatsView directly) because
// tasks.md 3.2 leaves "build the URL here or inside SuperchargerRow" as an
// implementer's choice, and SuperchargerRowVM itself carries no window
// field (only SuperchargerStatsView does) — a per-row Edit URL cannot be
// built without them reaching this component somehow. Every row action URL
// carries them so the row-level handlers' list-and-match resolve (D1) stays
// deterministic against the currently-rendered window.
//
// csrfToken is threaded through for signature symmetry with the edit row
// (SuperchargerRowEdit) even though the static row itself issues no write —
// Edit is a plain GET, so no CSRF token is needed here; it exists to keep
// the two components' call sites (both driven from superchargerTable, wave
// 3.2) uniform.
//
// NO delete action exists for a Supercharger session (design.md Non-Goals) —
// unlike ExternalChargeRow, this row has exactly one action button and no
// hx-confirm.
//
// The Status column pairs a ui.Dot with the text ui.Badge, and BOTH survive on a
// phone — the badge shrinks (CompactOnMobile) instead of being hidden (MAG-46 step
// 4.2). Hiding it left the status as colour alone, and colour alone is a poor sole
// carrier of meaning: `title` tooltips never fire on touch, so a sighted phone user
// had nothing but a hue to read.
//
// Here the dot's colours and the badge's Kinds MAY overlap (both carry `neutral` for
// DONE_CALCULATED), and that is not the collision AGENTS.md §"UI stack" warns about.
// That warning is about ExternalChargeRow, where the dot means DATA COMPLETENESS and the
// badge means LIFECYCLE — two different signals, so sharing a colour would make one
// read as the other. This row has a single signal: dot and badge are two renderings
// of the SAME status, so agreeing in colour is correct. Do not "fix" it by forcing
// them apart.
templ SuperchargerRow(vm SuperchargerRowVM, csrfToken, windowStartStr, windowEndStr string) {
	<tr id={ "supercharger-row-" + vm.ID }>
		<td>
			<span class="sm:hidden">{ vm.DateShortLabel }</span>
			<span class="hidden sm:inline">{ vm.DateLabel }</span>
		</td>
		<td>
			<div class="flex items-center gap-2">
				if vm.RawStatus == "DONE" {
					@ui.Dot(ui.DotProps{Variant: "success", Tooltip: i18n.T(ctx, i18n.KeySuperchargerBadgeDone)})
					@ui.Badge(ui.BadgeProps{Kind: "primary", Text: i18n.T(ctx, i18n.KeySuperchargerBadgeDone), CompactOnMobile: true})
				} else if vm.RawStatus == "DONE_CALCULATED" {
					@ui.Dot(ui.DotProps{Variant: "neutral", Tooltip: i18n.T(ctx, i18n.KeySuperchargerBadgeDoneCalculated)})
					// Two badges, one status: the full label from `sm` up, the phone-width
					// one below it. This is the ONLY status whose copy needs the split —
					// see KeySuperchargerBadgeDoneCalculatedShort for the measurement. The
					// dot's tooltip keeps the FULL wording in both cases.
					@ui.Badge(ui.BadgeProps{Kind: "neutral", Text: i18n.T(ctx, i18n.KeySuperchargerBadgeDoneCalculatedShort), CompactOnMobile: true, Class: "sm:hidden"})
					@ui.Badge(ui.BadgeProps{Kind: "neutral", Text: i18n.T(ctx, i18n.KeySuperchargerBadgeDoneCalculated), Class: "hidden sm:inline-flex"})
				} else {
					@ui.Dot(ui.DotProps{Variant: "warning", Tooltip: i18n.T(ctx, i18n.KeySuperchargerBadgeInProgress)})
					@ui.Badge(ui.BadgeProps{Kind: "ghost", Text: i18n.T(ctx, i18n.KeySuperchargerBadgeInProgress), CompactOnMobile: true})
				}
			</div>
		</td>
		<td class="hidden sm:table-cell">{ vm.SiteLabel }</td>
		<td class="hidden sm:table-cell">{ vm.EnergyLabel }</td>
		<td class="hidden sm:table-cell">{ vm.CostLabel }</td>
		<td class="hidden sm:table-cell">{ vm.StartBatteryPctLabel }</td>
		<td class="hidden sm:table-cell">{ vm.EndBatteryPctLabel }</td>
		<td>
			@ui.Button(ui.ButtonProps{
				Variant: "ghost",
				Size:    "sm",
				Attrs: templ.Attributes{
					// Icon-only on a phone, so the label must still reach a screen
					// reader (AGENTS.md §Mobile R7). Mirrors ExternalChargeRow's Edit button.
					"aria-label": i18n.T(ctx, i18n.KeySuperchargerRowEdit),
					"hx-get":     fmt.Sprintf("/ui/supercharger-stats/row/%s/edit?start=%s&end=%s", vm.ID, windowStartStr, windowEndStr),
					"hx-target":  "#supercharger-row-" + vm.ID,
					"hx-swap":    "outerHTML",
				},
			}) {
				@ui.Icon(ui.IconProps{Name: "edit", Class: "h-4 w-4 sm:hidden"})
				<span class="hidden sm:inline">{ i18n.T(ctx, i18n.KeySuperchargerRowEdit) }</span>
			}
		</td>
	</tr>
}

// SuperchargerRowError renders an error <tr> when a row-level write fails on
// an existing session. colspan="8" matches the
// static row's full column count (7 data cells + Actions, design.md D10 —
// the header count after 3.2 adds the "Actions" header).
templ SuperchargerRowError(id string, msg string) {
	<tr id={ "supercharger-row-" + id }>
		<td colspan="8">
			<span class="text-error">{ msg }</span>
		</td>
	</tr>
}
