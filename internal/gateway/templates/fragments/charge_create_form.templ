package fragments

import (
	"github.com/cristianpena/magus-tesla-api/internal/gateway/i18n"
	"github.com/cristianpena/magus-tesla-api/internal/gateway/templates/ui"
)

// ChargeCreateForm renders the "Log a charge" create form.
// Its root <div id="charges-create-form"> matches the templ.Fragment name and
// is the hx-target for the create POST (required invariant — design.md D1).
// validationErrors maps field names to error messages; nil or empty means no errors.
// Every form control is composed from the ui/ adapter kit (Field/Input/Select/
// Textarea) — no raw DaisyUI component classes live here, so a DaisyUI upgrade is
// a one-file change in ui/, not a sweep across this form.
//
// MAG-5 / D1-D7 form wiring (see openspec/changes/gateway-improve-manual-charge-form):
//   - D1: charged_on ("Date"), started_at and ended_at are in the main card grid (not
//     behind "More details") and all three are pre-filled with the user's current
//     calendar day from ChargesPageData.DefaultChargedOn / DefaultStartedAt /
//     DefaultEndedAt — one day value in buildChargesPage feeds all three, so they
//     cannot drift. charged_on is REQUIRED; started_at / ended_at stay OPTIONAL —
//     clearing either still submits.
//   - D2/D6: start_battery_pct is unconditionally REQUIRED (UI + handler); the
//     start input carries a telemetry-sourced suggestion via its placeholder
//     (ChargesPageData.StartBatteryPctSuggestion); empty placeholder when no
//     snapshot — no fabricated value (graceful empty). end_battery_pct's
//     required-ness is conditional as of RM33 (see below).
//   - D4: there is NO Vehicle picker — the vehicle is sourced from the sidebar
//     switcher's session-selected vehicle (resolveSelectedVehicle in parseChargeForm).
//   - D7: energy_added_kwh step is 0.001 (3-decimal precision preserved), keeping
//     the browser's nearest-valid-range helper behavior (now after 3 decimals).
//
// RM33 (MAG-18) additions, design.md §D-Fields/§D-Suffix/§D-Values:
//   - A status <select> (IN_PROGRESS/DONE) is the first field; its default
//     selection comes from d.FormValues.Status (set to IN_PROGRESS by
//     buildChargesPage on a fresh load, or the submitted value on a 4xx
//     re-render).
//   - ended_at / end_battery_pct's Required is bound to
//     d.RequiredEndedAt / d.RequiredEndBatteryPct (handler-computed from
//     charging.RequiredFieldsFor — never computed here).
//   - energy_added_kwh and price are genuinely optional (D7 roadmap decision);
//     the disabled Currency input is REMOVED — price instead renders a "COP"
//     suffix via ui.InputProps.Suffix (design.md §D-Suffix).
//   - Every submitted value survives a validation failure via
//     d.FormValues (design.md §D-Values, roadmap D15).
//   - odometer_km is a new optional field inside "More details" (D-RM33-7).
//
// Success notice: a non-empty d.Notice renders a success ui.Alert above the
// form (the same slot the _top validation Alert uses, one kind apart). Only
// ChargeCreate's success path sets it, so it rides in on the create response's
// primary #charges-create-form swap and is gone on the next render.
//
// RM33 tier 3 addition, design.md §D-Include: the <form> carries
// hx-include="#charges-window-start, #charges-window-end" — a plain,
// declarative htmx attribute (not client-side JS, needs no RD entry) that
// folds the two hidden window inputs rendered inside #charges-list into this
// form's request at SUBMIT time, so the create write's post-write OOB refresh
// (ChargeCreate -> windowFromForm) targets whichever filter window is
// currently active, even though this form is a SIBLING of #charges-list, not
// a descendant of it.
templ ChargeCreateForm(d ChargesPageData, validationErrors map[string]string) {
	<div id="charges-create-form">
		@ui.Card(ui.CardProps{Title: i18n.T(ctx, i18n.KeyChargesFormTitle)}) {
			<p id="charges-create-hint" class="text-sm text-base-content/70">{ i18n.T(ctx, i18n.KeyChargesFormCreateHint) }</p>
			if d.Notice != "" {
				@ui.Alert(ui.AlertProps{Kind: "success"}) {
					{ d.Notice }
				}
			}
			if validationErrors["_top"] != "" {
				@ui.Alert(ui.AlertProps{Kind: "error"}) {
					{ validationErrors["_top"] }
				}
			}
			<form
				hx-post="/ui/charges/create"
				hx-target="#charges-create-form"
				hx-swap="outerHTML"
				hx-include="#charges-window-start, #charges-window-end"
				class="flex flex-col gap-3"
			>
				<input type="hidden" name="csrf_token" value={ d.CSRFToken }/>
				<div class="grid gap-3 sm:grid-cols-2">
					@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormStatus), Error: validationErrors["status"]}) {
						@ui.Select(ui.SelectProps{Name: "status", Required: true}) {
							<option value="IN_PROGRESS" selected?={ d.FormValues.Status == "IN_PROGRESS" }>{ i18n.T(ctx, i18n.KeyChargesFormStatusInProgress) }</option>
							<option value="DONE" selected?={ d.FormValues.Status == "DONE" }>{ i18n.T(ctx, i18n.KeyChargesFormStatusDone) }</option>
						}
					}
					@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormDate), Error: validationErrors["charged_on"]}) {
						@ui.Input(ui.InputProps{Type: "date", Name: "charged_on", Value: d.DefaultChargedOn, Required: true})
					}
					@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormEnergyAdded), Error: validationErrors["energy_added_kwh"], Optional: true}) {
						@ui.Input(ui.InputProps{Type: "number", Name: "energy_added_kwh", Value: d.FormValues.EnergyAddedKWh, Attrs: templ.Attributes{"step": "0.001", "min": "0.001"}})
					}
					@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormPrice), Error: validationErrors["price"], Optional: true}) {
						// i18n:allow: ISO currency code
						@ui.Input(ui.InputProps{Type: "number", Name: "price", Value: d.FormValues.Price, Suffix: "COP", Attrs: templ.Attributes{"step": "0.01", "min": "0"}})
					}
					// D1: optional date fields moved up from "More details"; default to today (pre-computed by the handler).
					@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormStartedAt), Error: validationErrors["started_at"], Optional: true}) {
						@ui.Input(ui.InputProps{Type: "datetime-local", Name: "started_at", Value: d.DefaultStartedAt})
					}
					@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormEndedAt), Error: validationErrors["ended_at"]}) {
						@ui.Input(ui.InputProps{Type: "datetime-local", Name: "ended_at", Value: d.DefaultEndedAt, Required: d.RequiredEndedAt})
					}
					// D6 + D2: required battery fields; start has a telemetry-sourced suggestion label (graceful empty when no snapshot).
					@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormStartBatteryPct), Error: validationErrors["start_battery_pct"]}) {
						@ui.Input(ui.InputProps{
							Type:     "number",
							Name:     "start_battery_pct",
							Value:    d.FormValues.StartBatteryPct,
							Required: true,
							Attrs: templ.Attributes{"min": "0", "max": "100", "step": "1", "placeholder": d.StartBatteryPctSuggestion},
						})
					}
					@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormEndBatteryPct), Error: validationErrors["end_battery_pct"]}) {
						@ui.Input(ui.InputProps{Type: "number", Name: "end_battery_pct", Value: d.FormValues.EndBatteryPct, Required: d.RequiredEndBatteryPct, Attrs: templ.Attributes{"min": "0", "max": "100", "step": "1"}})
					}
					@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormLocation), Error: validationErrors["location_kind"]}) {
						@ui.Select(ui.SelectProps{Name: "location_kind", Required: true}) {
							<option value="HOME" selected?={ d.FormValues.LocationKind == "HOME" }>{ i18n.T(ctx, i18n.KeyChargesFormHome) }</option>
							<option value="WORK" selected?={ d.FormValues.LocationKind == "WORK" }>{ i18n.T(ctx, i18n.KeyChargesFormWork) }</option>
							<option value="OTHER" selected?={ d.FormValues.LocationKind == "OTHER" }>{ i18n.T(ctx, i18n.KeyChargesFormOther) }</option>
						}
					}
				</div>
				<section id="charges-create-optional">
					<h3 class="font-medium text-base-content/70">{ i18n.T(ctx, i18n.KeyChargesFormOptionalDetails) }</h3>
					<div class="grid gap-3 sm:grid-cols-2 mt-2">
						@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormChargingType)}) {
							@ui.Select(ui.SelectProps{Name: "charging_type"}) {
								<option value="">-</option>
								<option value="AC" selected?={ d.FormValues.ChargingType == "AC" }>{ i18n.T(ctx, i18n.KeyChargesFormAC) }</option>
								<option value="DC" selected?={ d.FormValues.ChargingType == "DC" }>{ i18n.T(ctx, i18n.KeyChargesFormDC) }</option>
							}
						}
						@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormLocationLabel)}) {
							@ui.Input(ui.InputProps{Name: "location_label", Value: d.FormValues.LocationLabel})
						}
						@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormOdometer), Error: validationErrors["odometer_km"]}) {
							@ui.Input(ui.InputProps{Type: "number", Name: "odometer_km", Value: d.FormValues.OdometerKm, Attrs: templ.Attributes{"min": "0", "step": "1"}})
						}
						@ui.Field(ui.FieldProps{Label: i18n.T(ctx, i18n.KeyChargesFormNotes), Class: "sm:col-span-2"}) {
							@ui.Textarea(ui.TextareaProps{Name: "notes"}) { { d.FormValues.Notes } }
						}
					</div>
				</section>
				<div>
					@ui.Button(ui.ButtonProps{Type: "submit", Variant: "primary"}) {
						{ i18n.T(ctx, i18n.KeyChargesFormLogCharge) }
					}
				</div>
			</form>
		}
	</div>
}

// ChargeCreateSuccessOOB renders the create-success response: a reset create form
// (the primary swap target #charges-create-form) plus an OOB swap to refresh
// #charges-list. Both are returned in one response body so htmx applies both
// in a single round-trip using hx-swap-oob="outerHTML" (design.md D1 + htmx OOB).
templ ChargeCreateSuccessOOB(d ChargesPageData) {
	@ChargeCreateForm(d, nil)
	<div id="charges-list" hx-swap-oob="outerHTML:#charges-list">
		@ChargesList(d)
	</div>
}
