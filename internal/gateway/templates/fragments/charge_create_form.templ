package fragments

import "github.com/cristianpena/magus-tesla-api/internal/gateway/templates/ui"

// ChargeCreateForm renders the "Log a charge" create form.
// Its root <div id="charges-create-form"> matches the templ.Fragment name and
// is the hx-target for the create POST (required invariant — design.md D1).
// validationErrors maps field names to error messages; nil or empty means no errors.
// Every form control is composed from the ui/ adapter kit (Field/Input/Select/
// Textarea) — no raw DaisyUI component classes live here, so a DaisyUI upgrade is
// a one-file change in ui/, not a sweep across this form.
templ ChargeCreateForm(d ChargesPageData, validationErrors map[string]string) {
	<div id="charges-create-form">
		@ui.Card(ui.CardProps{Title: "Log a charge"}) {
			if validationErrors["_top"] != "" {
				@ui.Alert(ui.AlertProps{Kind: "error"}) {
					{ validationErrors["_top"] }
				}
			}
			<form
				hx-post="/ui/charges/create"
				hx-target="#charges-create-form"
				hx-swap="outerHTML"
				class="flex flex-col gap-3"
			>
				<input type="hidden" name="csrf_token" value={ d.CSRFToken }/>
				<div class="grid gap-3 sm:grid-cols-2">
					@ui.Field(ui.FieldProps{Label: "Date", Error: validationErrors["charged_on"]}) {
						@ui.Input(ui.InputProps{Type: "date", Name: "charged_on", Required: true})
					}
					@ui.Field(ui.FieldProps{Label: "Energy added (kWh)", Error: validationErrors["energy_added_kwh"]}) {
						@ui.Input(ui.InputProps{Type: "number", Name: "energy_added_kwh", Required: true, Attrs: templ.Attributes{"step": "0.01", "min": "0.01"}})
					}
					@ui.Field(ui.FieldProps{Label: "Price", Error: validationErrors["price"]}) {
						@ui.Input(ui.InputProps{Type: "number", Name: "price", Required: true, Attrs: templ.Attributes{"step": "0.01", "min": "0"}})
					}
					@ui.Field(ui.FieldProps{Label: "Currency", Error: validationErrors["currency"]}) {
						@ui.Input(ui.InputProps{Name: "currency", Value: "COP", Required: true})
					}
					@ui.Field(ui.FieldProps{Label: "Location", Error: validationErrors["location_kind"]}) {
						@ui.Select(ui.SelectProps{Name: "location_kind", Required: true}) {
							<option value="HOME">Home</option>
							<option value="WORK">Work</option>
							<option value="OTHER">Other</option>
						}
					}
					@ui.Field(ui.FieldProps{Label: "Vehicle", Error: validationErrors["vehicle"]}) {
						if d.SingleVehicle {
							@ui.Select(ui.SelectProps{Name: "vehicle", Disabled: true}) {
								for _, opt := range d.VehicleOptions {
									<option value={ opt.Value } selected?={ opt.Selected }>{ opt.DisplayName }</option>
								}
							}
							for _, opt := range d.VehicleOptions {
								if opt.Selected {
									<input type="hidden" name="vehicle" value={ opt.Value }/>
								}
							}
						} else {
							@ui.Select(ui.SelectProps{Name: "vehicle", Required: true}) {
								for _, opt := range d.VehicleOptions {
									<option value={ opt.Value } selected?={ opt.Selected }>{ opt.DisplayName }</option>
								}
							}
						}
					}
				</div>
				<details>
					<summary class="cursor-pointer font-medium">More details</summary>
					<div class="grid gap-3 sm:grid-cols-2 mt-2">
						@ui.Field(ui.FieldProps{Label: "Started at"}) {
							@ui.Input(ui.InputProps{Type: "datetime-local", Name: "started_at"})
						}
						@ui.Field(ui.FieldProps{Label: "Ended at"}) {
							@ui.Input(ui.InputProps{Type: "datetime-local", Name: "ended_at"})
						}
						@ui.Field(ui.FieldProps{Label: "Start battery %"}) {
							@ui.Input(ui.InputProps{Type: "number", Name: "start_battery_pct", Attrs: templ.Attributes{"min": "0", "max": "100", "step": "1"}})
						}
						@ui.Field(ui.FieldProps{Label: "End battery %"}) {
							@ui.Input(ui.InputProps{Type: "number", Name: "end_battery_pct", Attrs: templ.Attributes{"min": "0", "max": "100", "step": "1"}})
						}
						@ui.Field(ui.FieldProps{Label: "Charging type"}) {
							@ui.Select(ui.SelectProps{Name: "charging_type"}) {
								<option value="">-</option>
								<option value="AC">AC</option>
								<option value="DC">DC</option>
							}
						}
						@ui.Field(ui.FieldProps{Label: "Location label"}) {
							@ui.Input(ui.InputProps{Name: "location_label"})
						}
						@ui.Field(ui.FieldProps{Label: "Notes", Class: "sm:col-span-2"}) {
							@ui.Textarea(ui.TextareaProps{Name: "notes"})
						}
					</div>
				</details>
				<div>
					@ui.Button(ui.ButtonProps{Type: "submit", Variant: "primary"}) {
						Log charge
					}
				</div>
			</form>
		}
	</div>
}

// ChargeCreateSuccessOOB renders the create-success response: a reset create form
// (the primary swap target #charges-create-form) plus an OOB swap to refresh
// #charges-list. Both are returned in one response body so htmx applies both
// in a single round-trip using hx-swap-oob="outerHTML" (design.md D1 + htmx OOB).
templ ChargeCreateSuccessOOB(d ChargesPageData) {
	@ChargeCreateForm(d, nil)
	<div id="charges-list" hx-swap-oob="outerHTML:#charges-list">
		@ChargesList(d)
	</div>
}
