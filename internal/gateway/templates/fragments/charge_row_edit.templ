package fragments

import "github.com/cristianpena/magus-tesla-api/internal/gateway/templates/ui"

// ChargeRowEdit renders the inline edit form for a single charge entry row.
// Its id="charge-row-{vm.ID}" matches the static row's id so htmx
// hx-swap="outerHTML" can swap between the two views in-place.
// validationErrors maps field names to error messages; nil or empty means no errors.
// Every control is composed from the ui/ adapter kit (Field/Input/Select/Textarea)
// — no raw DaisyUI component classes live here.
//
// The hx-put lives on the <form> and Save is type="submit" — NOT hx-put on the
// button. This is load-bearing, not style: htmx only runs HTML5 constraint
// validation when the element issuing the request is the form itself
// (`elt instanceof HTMLFormElement || hx-validate="true"`), and a type="button"
// never triggers the browser's own submit-time validation either. With hx-put on
// the button, every `Required: true` below was inert and an empty required field
// went straight to the server as a 422. Keep the request on the form.
//
// MAG-5 alignment with the create form (D4/D5/D6/D7): currency is a disabled,
// read-only COP input (D5); start/end battery % are REQUIRED (D6); energy is
// 3-decimal (step=0.001, D7). The hidden `vehicle` form input was removed (D4 —
// parseChargeForm sources the vehicle from the session selection); the
// read-only VehicleLabel span stays for display transparency.
templ ChargeRowEdit(vm ChargeEntryVM, csrfToken string, validationErrors map[string]string) {
	<tr id={ "charge-row-" + vm.ID }>
		<td colspan="8">
			if validationErrors["_top"] != "" {
				@ui.Alert(ui.AlertProps{Kind: "error"}) {
					{ validationErrors["_top"] }
				}
			}
			<form
				hx-put={ "/ui/charges/row/" + vm.ID }
				hx-target={ "#charge-row-" + vm.ID }
				hx-swap="outerHTML"
				class="flex flex-col gap-3"
			>
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<input type="hidden" name="id" value={ vm.ID }/>
				<div class="grid gap-3 sm:grid-cols-2">
					@ui.Field(ui.FieldProps{Label: "Date", Error: validationErrors["charged_on"]}) {
						@ui.Input(ui.InputProps{Type: "date", Name: "charged_on", Value: vm.RawChargedOn, Required: true})
					}
					@ui.Field(ui.FieldProps{Label: "Energy added (kWh)", Error: validationErrors["energy_added_kwh"]}) {
						@ui.Input(ui.InputProps{Type: "number", Name: "energy_added_kwh", Value: vm.RawEnergyKWh, Required: true, Attrs: templ.Attributes{"step": "0.001", "min": "0.001"}})
					}
					@ui.Field(ui.FieldProps{Label: "Price", Error: validationErrors["price"]}) {
						@ui.Input(ui.InputProps{Type: "number", Name: "price", Value: vm.RawPrice, Required: true, Attrs: templ.Attributes{"step": "0.01", "min": "0"}})
					}
					@ui.Field(ui.FieldProps{Label: "Currency"}) {
						@ui.Input(ui.InputProps{Name: "currency", Value: vm.Currency, Disabled: true})
					}
					@ui.Field(ui.FieldProps{Label: "Vehicle"}) {
						<span class="text-base-content/80">{ vm.VehicleLabel }</span>
					}
					@ui.Field(ui.FieldProps{Label: "Start battery %", Error: validationErrors["start_battery_pct"]}) {
						@ui.Input(ui.InputProps{Type: "number", Name: "start_battery_pct", Value: vm.RawStartBatteryPct, Required: true, Attrs: templ.Attributes{"min": "0", "max": "100", "step": "1"}})
					}
					@ui.Field(ui.FieldProps{Label: "End battery %", Error: validationErrors["end_battery_pct"]}) {
						@ui.Input(ui.InputProps{Type: "number", Name: "end_battery_pct", Value: vm.RawEndBatteryPct, Required: true, Attrs: templ.Attributes{"min": "0", "max": "100", "step": "1"}})
					}
				</div>
				<details>
					<summary class="cursor-pointer font-medium">More details</summary>
					<div class="grid gap-3 sm:grid-cols-2 mt-2">
						@ui.Field(ui.FieldProps{Label: "Started at", Error: validationErrors["started_at"]}) {
							@ui.Input(ui.InputProps{Type: "datetime-local", Name: "started_at", Value: vm.RawStartedAt})
						}
						@ui.Field(ui.FieldProps{Label: "Ended at", Error: validationErrors["ended_at"]}) {
							@ui.Input(ui.InputProps{Type: "datetime-local", Name: "ended_at", Value: vm.RawEndedAt})
						}
						@ui.Field(ui.FieldProps{Label: "Charging type"}) {
							@ui.Select(ui.SelectProps{Name: "charging_type"}) {
								<option value="">-</option>
								<option value="AC" selected?={ vm.ChargingType == "AC" }>AC</option>
								<option value="DC" selected?={ vm.ChargingType == "DC" }>DC</option>
							}
						}
						@ui.Field(ui.FieldProps{Label: "Location kind", Error: validationErrors["location_kind"]}) {
							@ui.Select(ui.SelectProps{Name: "location_kind", Required: true}) {
								<option value="HOME" selected?={ vm.LocationKind == "HOME" }>Home</option>
								<option value="WORK" selected?={ vm.LocationKind == "WORK" }>Work</option>
								<option value="OTHER" selected?={ vm.LocationKind == "OTHER" }>Other</option>
							}
						}
						@ui.Field(ui.FieldProps{Label: "Location label"}) {
							@ui.Input(ui.InputProps{Name: "location_label", Value: vm.LocationLabel})
						}
						@ui.Field(ui.FieldProps{Label: "Notes", Class: "sm:col-span-2"}) {
							@ui.Textarea(ui.TextareaProps{Name: "notes"}) { { vm.Notes } }
						}
					</div>
				</details>
				<div class="flex gap-2">
					@ui.Button(ui.ButtonProps{Type: "submit", Variant: "primary", Size: "sm"}) {
						Save
					}
					@ui.Button(ui.ButtonProps{
						Variant: "ghost",
						Size:    "sm",
						Attrs: templ.Attributes{
							"hx-get":    "/ui/charges/row/" + vm.ID,
							"hx-target": "#charge-row-" + vm.ID,
							"hx-swap":   "outerHTML",
						},
					}) {
						Cancel
					}
				</div>
			</form>
		</td>
	</tr>
}
