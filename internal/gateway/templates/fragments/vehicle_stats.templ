package fragments

import (
	"context"
	"fmt"
	"strconv"

	"github.com/cristianpena/magus-tesla-api/internal/gateway/i18n"
	"github.com/cristianpena/magus-tesla-api/internal/gateway/templates/ui"
)

// VehicleStatsContent renders the vehicle-scoped body of the Vehicle Stats
// page — everything inside #vehicle-stats-content. It is served both by the
// full page load (through VehicleStatsPage) and by the htmx swap on
// GET /ui/vehicle-stats, so one template tree covers the first render, the
// vehicle switch and every period change (mirrors SuperchargerStatsContent).
//
// The period control is rendered HERE, at the top of this region, and NOT in
// the page header beside the title where it visually belongs. That is forced,
// not preferred: the header sits outside #vehicle-stats-content, so a swap
// would leave its button still naming the previous period. Right-aligning it
// directly under the header buys the same reading with none of that staleness.
templ VehicleStatsContent(v VehicleStatsView) {
	if v.Periods != nil {
		<div class="flex items-center justify-end gap-2 -mt-2">
			<span class="text-sm text-base-content/60">{ i18n.T(ctx, i18n.KeyVehicleStatsPeriodLabel) }</span>
			@ui.Dropdown(ui.DropdownProps{
				ID:        "vehicle-stats-period",
				Label:     v.PeriodLabel,
				AriaLabel: i18n.T(ctx, i18n.KeyVehicleStatsPeriodAria),
				End:       true,
				Scroll:    true,
				Items:     vehicleStatsPeriodItems(v.Periods),
			})
		</div>
	}
	if v.Error != "" {
		@ui.Alert(ui.AlertProps{Kind: "error", Class: "mb-4"}) {
			{ v.Error }
		}
	} else if v.Empty {
		@ui.Card(ui.CardProps{ID: "vehicle-stats-empty"}) {
			<p class="text-base-content/70">{ i18n.T(ctx, i18n.KeyVehicleStatsEmpty) }</p>
		}
	} else {
		@ui.Card(ui.CardProps{Title: i18n.T(ctx, i18n.KeyVehicleStatsSummaryTitle), Desc: vehicleStatsSummaryDesc(ctx, v.HasPrev), ID: "vehicle-stats-summary"}) {
			@vehicleStatsTiles(v.Tiles)
		}
		if v.MonthChart.Show {
			@ui.Card(ui.CardProps{Title: i18n.T(ctx, i18n.KeyVehicleStatsMonthChartTitle), Desc: i18n.T(ctx, i18n.KeyVehicleStatsMonthChartDesc), ID: "vehicle-stats-month-chart"}) {
				@historyBarChart(v.MonthChart.Chart, "fill-primary")
			}
		}
		if len(v.Gaps) > 0 {
			@vehicleStatsGaps(v.Gaps, v.GapsMore)
		}
		@vehicleStatsWhy(v.Why)
	}
}

// vehicleStatsPeriodItems maps the view model's periods onto the ui kit's
// menu rows. Each row carries its OWN complete hx-get with ?start= and ?end=
// already resolved, which is what keeps this page on the platform's single
// date-filter vocabulary (AGENTS.md §HTTP date-filter convention) with no
// client-side JavaScript — one option of a native select element holds a
// single value, so two coupled query params would otherwise need a script.
//
// A pure presentation mapping owned by the template file, the same precedent
// firstWord (vehicle_select.templ) and navBadgeKind set: it reshapes a VM for
// a component, it decides nothing.
func vehicleStatsPeriodItems(periods []VehicleStatsPeriod) []ui.DropdownItem {
	items := make([]ui.DropdownItem, 0, len(periods))
	for _, p := range periods {
		items = append(items, ui.DropdownItem{
			Label:  p.Label,
			Active: p.Active,
			Indent: p.IsMonth,
			Attrs: templ.Attributes{
				"hx-get":    fmt.Sprintf("/ui/vehicle-stats?start=%s&end=%s", p.StartStr, p.EndStr),
				"hx-target": "#vehicle-stats-content",
				"hx-swap":   "innerHTML",
			},
		})
	}
	return items
}

// vehicleStatsTiles renders the period's seven KPIs in THREE tiers of weight,
// not seven equal cards.
//
// The ticket asked for this directly ("I wouldn't show 20+ cards"), and the
// reason it works is that the seven do not answer equally. Distance and
// efficiency answer "how did the car do" on their own — they get the headline
// size. The four charging figures are the ledger behind the cost, equal to each
// other and quieter. Range at full battery is not a period figure at all: it is
// a battery-health reading from the latest month, so it sits apart, last and
// smallest, where it cannot be mistaken for a total.
templ vehicleStatsTiles(t VehicleStatsTiles) {
	<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
		@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyVehicleStatsDistance), Value: t.Distance, Size: "lg", Trend: t.DistanceTrend, Desc: t.DistanceDelta})
		@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyVehicleStatsEfficiency), Value: t.Efficiency, Size: "lg", Trend: t.EfficiencyTrend, Desc: t.EfficiencyDelta})
	</div>
	<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-2">
		@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyVehicleStatsEnergy), Value: t.Energy, Trend: t.EnergyTrend, Desc: t.EnergyDelta})
		@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyVehicleStatsSessions), Value: t.Sessions, Trend: t.SessionsTrend, Desc: t.SessionsDelta})
		@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyVehicleStatsCost), Value: t.Cost, Trend: t.CostTrend, Desc: t.CostDelta})
		@ui.StatTile(ui.StatTileProps{Label: i18n.T(ctx, i18n.KeyVehicleStatsCostPerKm), Value: t.CostPerKm, Trend: t.CostPerKmTrend, Desc: t.CostPerKmDelta})
	</div>
	<div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mt-4 pt-3 border-t border-base-300 text-sm">
		<span class="text-base-content/70">{ i18n.T(ctx, i18n.KeyVehicleStatsRangeFull) }</span>
		<span class="font-mono font-semibold">{ t.RangeFull }</span>
		<span class="text-base-content/50">{ i18n.T(ctx, i18n.KeyVehicleStatsRangeFullDesc) }</span>
	</div>
}

// vehicleStatsGaps renders the missing-charge-records warning as a grid of one
// cell per day that needs a record.
//
// It sits ABOVE the "why" section and directly below the figures, because it is
// not an explanation — it is a caveat ON those figures. A missing charge
// under-counts consumption, which pushes energy and cost down and efficiency up,
// so a reader who has seen the numbers must see this before they trust them.
//
// # Why a grid of day cells and not a list of rows
//
// The first version was a list, each row carrying a date, a full sentence and a
// button on one line. Three competing elements per row wrapped badly on a phone,
// and the sentence was IDENTICAL in every row — four repetitions of "a charge
// record is missing" is noise, not information.
//
// What actually varies per day is the DATE and the KIND, so the date is the
// cell's anchor (a reader scans these to find which days they owe a record for),
// the kind is a badge, and the explanation is said ONCE in the section's
// description. The whole cell is the link, so nothing competes with it — and
// there is no "→" appended to the label, which is the generic tell this avoids.
//
// The warning tone is carried per cell by a left border rather than by wrapping
// the section in one big alert: that keeps the block visually consistent with
// every other card on the page while still reading as a warning.
templ vehicleStatsGaps(gaps []VehicleStatsGap, more int) {
	@ui.Card(ui.CardProps{Title: i18n.T(ctx, i18n.KeyVehicleStatsGapsTitle), Desc: i18n.T(ctx, i18n.KeyVehicleStatsGapsDesc), ID: "vehicle-stats-gaps"}) {
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
			for _, g := range gaps {
				<a
					href={ templ.SafeURL(g.ActionHref) }
					class="group flex flex-col gap-3 rounded-lg border border-base-300 border-l-4 border-l-warning bg-base-200/40 p-3 transition-colors hover:bg-base-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-warning"
				>
					<div class="flex items-start justify-between gap-2">
						<div class="flex flex-col leading-tight">
							<span class="font-mono text-2xl font-semibold">{ g.DayLabel }</span>
							<span class="text-xs text-base-content/60">{ g.MonthLabel }</span>
						</div>
						@ui.Badge(ui.BadgeProps{Kind: "warning", Text: g.KindLabel})
					</div>
					<span class="text-sm font-medium text-base-content/70 group-hover:text-base-content">{ g.ActionLabel }</span>
				</a>
			}
		</div>
		if more > 0 {
			<p class="mt-3 text-sm text-base-content/60">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyVehicleStatsGapsMore), more) }</p>
		}
	}
}

// vehicleStatsWhy renders the page's explanatory half — the "rest of the page"
// the ticket asked to progressively answer why the figures above look as they
// do. Each block answers ONE headline number, in the order those numbers appear.
//
// None of the three is a stat tile. A tile states a value; these state a
// comparison, a share and a distribution — the shapes that explain a value.
// Reusing tiles here would flatten the hierarchy the section above exists to
// build.
//
// # Layout: one full-width block, then two side by side
//
// "How you drove" stays full width — it is a two-column comparison already, and
// halving it would put four numbers in a quarter of the page.
//
// The other two pair into one row from `lg` up. Both are lists of short labelled
// meters, so each only ever needed about half the width; stacked, they made the
// reader scroll past two tall, mostly-empty blocks. `lg` and not `md` on purpose:
// the content area sits inside the drawer shell beside the sidebar, so a tablet
// has less usable width than its viewport suggests, and a meter row squeezed to a
// quarter of the screen stops being readable.
//
// Below `lg` it collapses to one column — the single-column stack is the right
// shape on a phone and is left exactly as it was.
templ vehicleStatsWhy(w VehicleStatsWhy) {
	// mt-6 on top of the container's own gap-6 gives the 3rem sectional break
	// the design system specifies between major functional blocks — applied
	// here, at the one place the page actually divides, rather than widening
	// every gap on the page.
	@ui.SectionHeader(ui.SectionHeaderProps{Title: i18n.T(ctx, i18n.KeyVehicleStatsWhyTitle), Desc: i18n.T(ctx, i18n.KeyVehicleStatsWhyDesc), Class: "mt-6"})
	@ui.Card(ui.CardProps{Title: i18n.T(ctx, i18n.KeyVehicleStatsHowDrivenTitle), Desc: i18n.T(ctx, i18n.KeyVehicleStatsHowDrivenDesc), ID: "vehicle-stats-how-driven"}) {
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			@vehicleStatsSplit(w.Weekday)
			@vehicleStatsSplit(w.Weekend)
		</div>
	}
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
		@ui.Card(ui.CardProps{Title: i18n.T(ctx, i18n.KeyVehicleStatsEnergyMixTitle), Desc: i18n.T(ctx, i18n.KeyVehicleStatsEnergyMixDesc), ID: "vehicle-stats-energy-mix"}) {
			<div class="flex flex-col gap-4">
				for _, src := range w.Sources {
					@vehicleStatsSource(src)
				}
			</div>
		}
		@ui.Card(ui.CardProps{Title: i18n.T(ctx, i18n.KeyVehicleStatsEndBattTitle), Desc: i18n.T(ctx, i18n.KeyVehicleStatsEndBattDesc), ID: "vehicle-stats-end-battery"}) {
			if w.BucketsEmpty {
				<p class="text-base-content/70">{ i18n.T(ctx, i18n.KeyVehicleStatsEndBattEmpty) }</p>
			} else {
				<div class="flex flex-col gap-3">
					for _, b := range w.Buckets {
						@vehicleStatsBucket(b)
					}
				</div>
			}
		}
	</div>
}

// vehicleStatsSplit renders one side of the weekday/weekend comparison. The day
// count is shown because it is what makes the comparison fair — the same km/%
// means much less over three days than over twenty.
templ vehicleStatsSplit(s VehicleStatsSplit) {
	<div class="flex flex-col gap-1">
		<span class="text-sm text-base-content/70">{ s.Label }</span>
		<div class="flex items-baseline gap-3">
			<span class="font-mono text-xl font-semibold">{ s.Efficiency }</span>
			<span class="font-mono text-base-content/70">{ s.Distance }</span>
		</div>
		<span class="text-xs text-base-content/50">{ s.Days }</span>
	</div>
}

// vehicleStatsSource renders one charging source: its share of the period's
// energy as a meter, then the figure that actually explains the cost — the
// price per kWh.
templ vehicleStatsSource(s VehicleStatsSource) {
	<div class="flex flex-col gap-1">
		<div class="flex flex-wrap items-baseline justify-between gap-x-3">
			<span class="text-sm">{ s.Label }</span>
			<span class="font-mono text-sm font-semibold">{ s.CostPerKWh }</span>
		</div>
		@ui.Progress(ui.ProgressProps{Value: s.SharePct, Max: 100, Class: "w-full h-2 text-primary", Attrs: templ.Attributes{"aria-label": fmt.Sprintf(i18n.T(ctx, i18n.KeyVehicleStatsSourceShare), pctLabel(s.SharePct))}})
		<div class="flex flex-wrap gap-x-3 text-xs text-base-content/60 font-mono">
			<span>{ s.Energy }</span>
			<span>{ s.Cost }</span>
			<span>{ s.Sessions }</span>
		</div>
	</div>
}

// vehicleStatsBucket renders one ending-battery band as a labelled meter. A
// horizontal meter, not five vertical bars: the labels are ranges like "80-100%"
// and would not fit under a narrow column on a phone.
templ vehicleStatsBucket(b VehicleStatsBucket) {
	<div class="flex items-center gap-3">
		<span class="w-20 shrink-0 font-mono text-xs text-base-content/70">{ b.Label }</span>
		@ui.Progress(ui.ProgressProps{Value: b.SharePct, Max: 100, Class: "flex-1 h-2 text-secondary", Attrs: templ.Attributes{"aria-label": fmt.Sprintf(i18n.T(ctx, i18n.KeyVehicleStatsEndBattShare), pctLabel(b.SharePct))}})
		<span class="w-8 shrink-0 text-right font-mono text-xs">{ b.Count }</span>
	</div>
}

// pctLabel renders a whole percentage for a screen-reader label — e.g. 42 ->
// "42%". A presentation mapping owned by this file, like firstWord in
// vehicle_select.templ. The "%" sign is language-neutral, so it carries no
// catalogue key; the surrounding sentence does.
func pctLabel(pct int) string {
	return strconv.Itoa(pct) + "%"
}

// vehicleStatsSummaryDesc says what the tiles' arrows are measured against, and
// says so ONCE on the card rather than repeating "vs. the previous period" in
// six tile sub-labels — each tile's own Desc carries its signed percentage
// instead.
//
// When no previous period has data it says that plainly. Staying silent would
// leave a reader wondering why the arrows vanished, and every tile carrying no
// arrow looks identical to a period that simply did not change.
func vehicleStatsSummaryDesc(ctx context.Context, hasPrev bool) string {
	if hasPrev {
		return i18n.T(ctx, i18n.KeyVehicleStatsSummaryDescPrev)
	}
	return i18n.T(ctx, i18n.KeyVehicleStatsSummaryDescNoPrev)
}
