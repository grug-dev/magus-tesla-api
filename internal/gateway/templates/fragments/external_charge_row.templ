package fragments

import (
	"fmt"

	"github.com/cristianpena/magus-tesla-api/internal/gateway/i18n"
	"github.com/cristianpena/magus-tesla-api/internal/gateway/templates/ui"
)

// ExternalChargeRow renders the static view of one charge entry as a table row.
// Its id="external-charge-row-{vm.ID}" matches the templ.Fragment id pattern and
// is the target for the inline-edit swap (required invariant).
//
// windowStartStr/windowEndStr are the SAME ?start=&end= window the table was
// rendered under (design.md §D-Refresh, mirrors SuperchargerRow's identical
// window-threading, supercharger_row.templ) — threaded into the Edit action's
// hx-get so a Cancel or a re-render of the static row never silently resets the
// user's active filter window.
//
// The Status column (2nd, right after the date) carries BOTH completeness
// signals D9 asks for: a ui.Dot colour indicator (vm.Complete, design.md
// §D-Dot) and a lifecycle ui.Badge keyed off vm.RawStatus — deliberately using
// "primary"/"ghost" Badge Kinds, never "success"/"warning", so the badge's
// colour vocabulary never collides with the adjacent dot's completeness colours.
//
// Delete's hx-target is "#external-charges-list" (the WHOLE list region), not
// "#external-charge-row-{id}" (design.md §D-Refresh) — after a successful delete the row
// no longer exists to swap into, so the delete button re-renders the whole
// filtered list/tiles instead, matching the filter buttons' own target.
templ ExternalChargeRow(vm ExternalChargeEntryVM, csrfToken, windowStartStr, windowEndStr string) {
	<tr id={ "external-charge-row-" + vm.ID }>
		<td>
			<span class="sm:hidden">{ vm.ChargedOnShortLabel }</span>
			<span class="hidden sm:inline">{ vm.ChargedOnLabel }</span>
		</td>
		<td>
			<div class="flex items-center gap-2">
				if vm.Complete {
					@ui.Dot(ui.DotProps{Variant: "success", Tooltip: i18n.T(ctx, i18n.KeyChargesDotCompleteTooltip)})
				} else {
					@ui.Dot(ui.DotProps{Variant: "warning", Tooltip: i18n.T(ctx, i18n.KeyChargesDotIncompleteTooltip)})
				}
				if vm.RawStatus == "DONE" {
					@ui.Badge(ui.BadgeProps{Kind: "primary", Text: i18n.T(ctx, i18n.KeyChargesBadgeDone), Class: "hidden sm:inline-flex"})
				} else {
					@ui.Badge(ui.BadgeProps{Kind: "ghost", Text: i18n.T(ctx, i18n.KeyChargesBadgeInProgress), Class: "hidden sm:inline-flex"})
				}
			</div>
		</td>
		<td class="hidden sm:table-cell">{ vm.EnergyKWh }</td>
		<td class="hidden sm:table-cell">{ vm.PriceLabel }</td>
		<td class="hidden sm:table-cell">{ vm.CostPerKWhLabel }</td>
		<td class="hidden sm:table-cell">{ vm.BatteryRange }</td>
		<td class="hidden sm:table-cell">{ vm.BatteryDelta }</td>
		<td class="hidden sm:table-cell">{ vm.DurationLabel }</td>
		<td>
			<div class="flex gap-2">
				@ui.Button(ui.ButtonProps{
					Variant: "ghost",
					Size:    "sm",
					Attrs: templ.Attributes{
						// On a phone this button shows only an icon, so the label the
						// sighted user loses must still reach a screen reader
						// (AGENTS.md §Mobile R7). Always present — it costs nothing on
						// desktop and cannot go stale by being conditional.
						"aria-label": i18n.T(ctx, i18n.KeyChargesRowEdit),
						"hx-get":     "/ui/external-charges/row/" + vm.ID + "/edit?start=" + windowStartStr + "&end=" + windowEndStr,
						"hx-target": "#external-charges-list",
						"hx-swap":   "outerHTML",
					},
				}) {
					@ui.Icon(ui.IconProps{Name: "edit", Class: "h-4 w-4 sm:hidden"})
					<span class="hidden sm:inline">{ i18n.T(ctx, i18n.KeyChargesRowEdit) }</span>
				}
				@ui.Button(ui.ButtonProps{
					Variant: "error",
					Size:    "sm",
					Outline: true,
					Attrs: templ.Attributes{
						// Icon-only on a phone — see the Edit button above.
						"aria-label": i18n.T(ctx, i18n.KeyChargesRowDelete),
						"hx-delete":  "/ui/external-charges/row/" + vm.ID + "?start=" + windowStartStr + "&end=" + windowEndStr,
						"hx-target": "#external-charges-list",
						"hx-swap":   "outerHTML",
						// hx-confirm is the message shown in the shared ui.ConfirmDialog
						// (static/app.js intercepts htmx's htmx:confirm event); the three
						// data-confirm-* attributes below are that dialog's per-use knobs.
						// Naming the actual entry beats a generic "Delete this entry?" —
						// the user confirms the row they meant, not the row they clicked.
						"hx-confirm":           fmt.Sprintf(i18n.T(ctx, i18n.KeyChargesRowConfirmMessage), vm.EnergyKWh, vm.ChargedOnLabel),
						"data-confirm-title":   i18n.T(ctx, i18n.KeyChargesRowConfirmTitle),
						"data-confirm-label":   i18n.T(ctx, i18n.KeyChargesRowConfirmLabel),
						"data-confirm-variant": "danger",
						// D3 — send the CSRF token on the X-CSRF-Token HEADER, not the
						// form body. Go's net/http only parses request bodies for POST/
						// PUT/PATCH (not DELETE), so the previous hx-include + hidden
						// #csrf-delete-<id> form input never reached checkCSRFKey's
						// c.PostForm("csrf_token") on a DELETE -> empty -> 403 ->
						// htmx alert(). checkCSRFKey already supports the header
						// fallback (X-CSRF-Token), so switching the wire path fixes the
						// delete-row alert (MAG-5 / D3, root-caused by static analysis).
						"hx-headers": `{"X-CSRF-Token": "` + csrfToken + `"}`,
						// csrfToken is the page-level ExternalChargesPageData.CSRFToken carried
						// down here from buildExternalChargesPage; it matches the live session
						// value (the issuing handler writes it to the session and the
						// row in the same render — see ExternalChargesContentFragment).
					},
				}) {
					@ui.Icon(ui.IconProps{Name: "delete", Class: "h-4 w-4 sm:hidden"})
					<span class="hidden sm:inline">{ i18n.T(ctx, i18n.KeyChargesRowDelete) }</span>
				}
			</div>
		</td>
	</tr>
}

// ChargeRowUpdateSuccessOOB was REMOVED (2026-08-29). It returned a primary
// table-row swap plus a sibling div carrying hx-swap-oob for the external-charges-list
// region, and that OOB refresh never reached the browser: htmx 2.0.4 parses a
// response inside a template element, a leading table row puts the HTML parser
// in table insertion mode, and the non-table sibling that follows is
// foster-parented off the fragment's top level — where hx-swap-oob is the only
// place htmx looks. ExternalChargeRowUpdate now answers a successful save with the
// whole external-charges-list fragment plus HX-Retarget, so there is exactly one
// response element and no table-row/div mix.
//
// Do NOT reintroduce a response that pairs a top-level table row with a
// non-table OOB sibling. ExternalChargeCreateSuccessOOB (external_charge_create_form.templ) is
// safe only because both of its elements are divs.
