package fragments

import (
	"github.com/cristianpena/magus-tesla-api/internal/gateway/i18n"
	"github.com/cristianpena/magus-tesla-api/internal/gateway/templates/ui"
)

// Vehicle is the clean presentation model for one vehicle — no vendor (...Tesla)
// suffix; the gateway maps the account module's domain Vehicle onto this before
// rendering. All snapshot-derived fields are display-ready and pre-computed by the
// handler (km conversion, staleness, sentry-nil handling, timestamp formatting) so
// the template stays logic-light (ai/htmx-conventions.md §"No business logic in templates").
type Vehicle struct {
	DisplayName string
	VIN         string

	// HasSnapshot is true when a stored nightly snapshot exists for this vehicle.
	// When false, the card renders in placeholder state ("no data yet").
	HasSnapshot bool

	// Extended fields — populated only when HasSnapshot is true.
	// All values are pre-formatted strings computed in the handler (unit included);
	// the template only reads these fields — no arithmetic, no fmt calls.
	Battery      string // e.g. "80%"
	BatteryRange string // e.g. "321.9 km"
	ChargingState string
	Odometer     string // e.g. "19312.1 km"
	InsideTemp   string // e.g. "22.5 °C"
	OutsideTemp  string // e.g. "15.0 °C"
	// Locked is a three-state pointer: nil = not reported, *false = unlocked, *true = locked
	// (RM38-gateway-read-dashboard-from-metrics, design.md D3 — was bool).
	Locked *bool
	// SentryMode is a three-state pointer: nil = not reported, *false = off, *true = on.
	SentryMode  *bool
	LastUpdated string // pre-formatted by the handler, e.g. "2006-01-02 15:04 UTC"
	IsStale     bool   // true when CapturedAt is older than stalenessThreshold (36 h)
}

// VehiclesData drives the vehicle-list region: the vehicles to show, or a notice
// (with an optional Connect prompt) when there are none to display.
type VehiclesData struct {
	Vehicles     []Vehicle
	Notice       string
	NeedsConnect bool
}

// VehiclesList is the htmx-swappable vehicle region. Its id ("vehicles") matches the
// fragment name so the same markup serves the full page and the htmx refresh.
templ VehiclesList(d VehiclesData) {
	<div id="vehicles">
		if d.Notice != "" && !d.NeedsConnect && len(d.Vehicles) > 0 {
			<p class="notice-banner">{ d.Notice }</p>
		}
		if len(d.Vehicles) > 0 {
			<ul>
				for _, v := range d.Vehicles {
					<li>
						<strong>{ v.DisplayName }</strong> — { v.VIN }
						if v.HasSnapshot {
							<ul>
								<li>{ i18n.T(ctx, i18n.KeyVehiclesBatteryLabel) } { v.Battery } / { i18n.T(ctx, i18n.KeyVehiclesRangeLabel) } { v.BatteryRange }</li>
								<li>{ i18n.T(ctx, i18n.KeyVehiclesChargingLabel) } { v.ChargingState }</li>
								<li>{ i18n.T(ctx, i18n.KeyVehiclesOdometerLabel) } { v.Odometer }</li>
								<li>{ i18n.T(ctx, i18n.KeyVehiclesInsideLabel) } { v.InsideTemp } / { i18n.T(ctx, i18n.KeyVehiclesOutsideLabel) } { v.OutsideTemp }</li>
								<li>
									if v.Locked == nil {
										{ i18n.T(ctx, i18n.KeyVehiclesNotReported) }
									} else if *v.Locked {
										{ i18n.T(ctx, i18n.KeyVehiclesLocked) }
									} else {
										{ i18n.T(ctx, i18n.KeyVehiclesUnlocked) }
									}
								</li>
								<li>
									{ i18n.T(ctx, i18n.KeyVehiclesSentryLabel) }
									if v.SentryMode == nil {
										{ i18n.T(ctx, i18n.KeyVehiclesNotReported) }
									} else if *v.SentryMode {
										{ i18n.T(ctx, i18n.KeyVehiclesOn) }
									} else {
										{ i18n.T(ctx, i18n.KeyVehiclesOff) }
									}
								</li>
								<li>
									{ i18n.T(ctx, i18n.KeyVehiclesLastUpdatedLabel) } { v.LastUpdated }
									if v.IsStale {
										@ui.Badge(ui.BadgeProps{Kind: "warning", Text: i18n.T(ctx, i18n.KeyVehiclesStaleBadge), Class: "ml-2"})
									}
								</li>
							</ul>
						} else {
							<p>{ i18n.T(ctx, i18n.KeyVehiclesNoDataYet) }</p>
						}
					</li>
				}
			</ul>
		} else if d.NeedsConnect {
			if d.Notice != "" {
				<p>{ d.Notice }</p>
			} else {
				<p>{ i18n.T(ctx, i18n.KeyNavHeaderNoTesla) }</p>
			}
			<p><a href="/connect/tesla">{ i18n.T(ctx, i18n.KeyNavHeaderConnectLink) }</a></p>
		} else {
			<p>{ d.Notice }</p>
		}
	</div>
}
