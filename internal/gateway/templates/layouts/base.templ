package layouts

import (
	"github.com/cristianpena/magus-tesla-api/internal/gateway/i18n"
	"github.com/cristianpena/magus-tesla-api/internal/gateway/templates/ui"
)

// seoImagePath is the ONE definition of which asset a link preview shows —
// WhatsApp, Slack, X, LinkedIn and iMessage all read og:image / twitter:image
// from it. It is a root-relative path here and made absolute per request by
// ui.Site.Asset, because a social scraper fetches the page from outside the
// browser session and cannot resolve a relative URL.
//
// The file lives in internal/gateway/static/img/, so it is embedded in the
// binary by gateway.staticFS (//go:embed static) and served by the app itself —
// no external CDN, exactly like app.css and htmx.min.js. Recommended source
// image: 1200x630 PNG under 300 KB (the size every scraper crops cleanly).
const seoImagePath = "/static/img/magus-logo.png"

// seoHead renders the search-engine and social-share metadata inside <head>.
// It is called by baseShell, so EVERY page gets exactly one copy and no page
// author has to remember the tag list.
//
// indexable splits the two audiences this app has:
//
//   - true (layouts.Base — the landing page, /login, the blocked-account page):
//     public pages a crawler and a share card should see, so they get the full
//     description + Open Graph + Twitter Card set.
//   - false (layouts.BaseAuth — dashboard, charges, Supercharger stats,
//     settings): per-user pages behind a session. They get robots noindex,nofollow
//     and NOTHING else. Emitting a description or an og:image for a private page
//     buys no SEO (a crawler never reaches it) and only risks leaking a page name
//     into a search index if a route is ever exposed by mistake.
//
// Language: every string resolves through i18n.T against the request language,
// so a visitor with no cookie — which is what a crawler always is — gets the
// catalogue's default, Spanish. There is no separate "default the metatags to
// Spanish" switch; that IS the default.
//
// Absolute URLs: canonical, og:url and the two image tags come from
// ui.SiteFromContext(ctx) (see ui/site.go). When no base URL is configured the
// Site helpers return "", and each such tag is skipped rather than emitted
// broken — a missing canonical costs a little SEO, a malformed one costs more.
templ seoHead(title string, indexable bool) {
	if !indexable {
		<meta name="robots" content="noindex, nofollow"/>
	} else {
		<meta name="description" content={ i18n.T(ctx, i18n.KeySEODescription) }/>
		<meta name="robots" content="index, follow"/>
		<meta property="og:type" content="website"/>
		<meta property="og:site_name" content={ i18n.T(ctx, i18n.KeyBrandMagusMonitor) }/>
		<meta property="og:locale" content={ i18n.OGLocale(ctx) }/>
		<meta property="og:title" content={ title }/>
		<meta property="og:description" content={ i18n.T(ctx, i18n.KeySEODescription) }/>
		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="twitter:title" content={ title }/>
		<meta name="twitter:description" content={ i18n.T(ctx, i18n.KeySEODescription) }/>
		if canonical := ui.SiteFromContext(ctx).Canonical(); canonical != "" {
			<link rel="canonical" href={ templ.SafeURL(canonical) }/>
			<meta property="og:url" content={ canonical }/>
		}
		if img := ui.SiteFromContext(ctx).Asset(seoImagePath); img != "" {
			<meta property="og:image" content={ img }/>
			<meta property="og:image:alt" content={ i18n.T(ctx, i18n.KeySEOImageAlt) }/>
			<meta name="twitter:image" content={ img }/>
			<meta name="twitter:image:alt" content={ i18n.T(ctx, i18n.KeySEOImageAlt) }/>
		}
		// JSON-LD structured data. templ.JSONScript writes the <script> element
		// AND encodes the payload; a hand-written <script> tag would NOT work
		// here, because templ treats a script element's contents as literal
		// text and would emit the expression verbatim. The empty id is omitted
		// from the output — nothing needs to find this block from JavaScript.
		// WithType is mandatory: the default is "application/json", which no
		// search engine reads as structured data.
		@templ.JSONScript("", seoJSONLD(ctx)).WithType("application/ld+json")
	}
}

// faviconLinks are the browser-tab and home-screen icons. They sit OUTSIDE
// seoHead on purpose: seoHead splits public from private, and a private page
// still needs a tab icon.
//
// Four tags over three files, each covering a client the others do not:
//
//   - favicon-32x32.png / favicon-16x16.png — every current browser. PNG is
//     preferred over the .ico by any browser that understands both, and the two
//     sizes cover a normal and a HiDPI tab strip.
//   - favicon.ico (48x48) — older browsers, and the bare /favicon.ico that a
//     crawler or feed reader requests before it ever parses the HTML (gateway.go
//     301s that root path here, so the file is reachable both ways).
//   - apple-touch-icon.png (180x180) — iOS "Add to Home Screen".
//
// Every href below names a file that EXISTS under static/img/favicon/. There is
// deliberately no favicon.svg link: this project's generator produced raster
// icons only, and a <link> to a missing file is a 404 on every page load for no
// benefit. If an SVG is added later, its tag goes first — browsers prefer the
// first format they understand.
//
// The manifest link is here rather than in seoHead for the same reason as the
// icons: installing the app is not an indexing concern, and it is served to
// every page. It points at the generated /site.webmanifest route
// (handlers.WebManifest), which is what gives favicon-192x192.png and
// favicon-512x512.png a job — Android reads those two sizes when a user adds the
// site to their home screen.
//
// Still unlinked, and therefore still dead weight in the binary:
// favicon-180x180.png (a byte-identical duplicate of apple-touch-icon.png) and
// favicon-48x48.png (the .ico already covers 48).
//
// Paths are root-relative, not absolute: unlike og:image these are resolved by a
// browser that already has the page's origin, so ui.Site is not needed.
templ faviconLinks() {
	<link rel="icon" type="image/png" href="/static/img/favicon/favicon-32x32.png" sizes="32x32"/>
	<link rel="icon" type="image/png" href="/static/img/favicon/favicon-16x16.png" sizes="16x16"/>
	<link rel="icon" type="image/x-icon" href="/static/img/favicon/favicon.ico" sizes="48x48"/>
	<link rel="apple-touch-icon" href="/static/img/favicon/apple-touch-icon.png" sizes="180x180"/>
	<link rel="manifest" href="/site.webmanifest"/>
}

// baseShell is the bare document shell shared by Base (anonymous pages) and
// BaseAuth (authenticated pages): <!DOCTYPE>/<html>/<head>/<body>, the DaisyUI
// theme + vendored asset tags, and the ONE shared confirmation modal
// (ui.ConfirmDialog, RD10), mounted here so both callers inherit it exactly
// once instead of each mounting — and risking duplicating — their own. It
// renders no navigation/chrome of its own; Base and BaseAuth each supply
// their own chrome around { children... }.
//
// data-theme reads ui.ThemeFromContext(ctx) (design.md D1,
// RM42-gateway-add-theme-selector tier 2) — the SAME per-request value
// PreferencesMiddleware already resolved (from account.Service.PreferencesFor
// for a signed-in request, or the theme cookie for an anonymous one; see
// preferences.go). This is no longer a literal in source: the previous
// hardcoded "graphite" meant every visitor and every account saw the same
// theme, with a source edit + make templ && make css required to change it.
// Now each request supplies its own value from context, exactly like
// i18n.FromContext(ctx) above it — the two attributes are populated the same
// way, from the same middleware, on the same line pattern.
templ baseShell(title string, indexable bool) {
	<!DOCTYPE html>
	<html lang={ i18n.FromContext(ctx) } data-theme={ ui.ThemeFromContext(ctx) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			@faviconLinks()
			@seoHead(title, indexable)
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body class="min-h-screen bg-base-100 text-base-content">
			{ children... }
			// The ONE shared confirmation modal, mounted here so every page (and every
			// htmx-swapped fragment inside it) can use it by putting hx-confirm on a
			// control. It lives OUTSIDE the swappable regions on purpose — a swap must
			// never replace the open dialog. See ui/confirm_dialog.templ.
		@ui.ConfirmDialog()
		// The iOS "Add to Home Screen" hint (RD16). Renders hidden on EVERY request
		// and is unhidden by app.js only on an iOS browser that is not already
		// running the installed app. Android gets nothing here by design — Chrome
		// raises its own install prompt from /site.webmanifest. Mounted beside the
		// dialog above for the same reason: one copy, outside every swap region.
		@ui.InstallHint()
	</body>
	</html>
}

// Base is the full-page HTML shell for unauthenticated pages (home, login). It sets
// the DaisyUI theme via <html data-theme> on baseShell above — resolved per REQUEST
// from ui.ThemeFromContext(ctx), not a literal in source (design.md D1/D2,
// RM42-gateway-add-theme-selector tier 2): a signed-in user's own stored preference
// (PreferencesMiddleware, preferences.go), or the anonymous theme cookie for a
// visitor with no session — the ONLY reason that cookie exists (see preferences.go's
// themeCookieName doc comment). One of ui.Themes ("apex" (Tesla-red), "graphite"
// (blue, WCAG-AA), or "halloween" (DaisyUI builtin fallback)) — all three are always
// compiled into app.css, so adding a FOURTH palette is still the four-step recipe in
// README.md "Switching the theme" (new CSS file, ui.Themes entry, make theme-guard,
// make templ && make css); it no longer changes what a given visitor SEES, only what
// is available to choose from /settings.
// Loads the vendored, minified Tailwind+DaisyUI
// stylesheet (/static/app.css) and the pinned htmx (/static/htmx.min.js) — both embedded
// in the binary, never an external CDN. DaisyUI is pure CSS with zero component
// JavaScript, so htmx fragment swaps stay styled with nothing to re-initialize.
// Composes baseShell with the anonymous-page chrome: a fixed-position language
// switcher (MAG-8 design D6 — "visible on every page including login") pinned
// top-right, since these pages have no navbar to host one. Callers must NOT
// mount their own ui.LangSwitcher — Base already provides it.
templ Base(title string) {
	@baseShell(title, true) {
		<div class="fixed top-3 right-3 z-40">
			@ui.LangSwitcher(ui.LangSwitcherProps{Current: i18n.FromContext(ctx)})
		</div>
		{ children... }
	}
}

// BaseAuth is the full-page shell for authenticated pages. It calls baseShell
// directly for the shared <head>/theme/body/ConfirmDialog document structure
// (NOT Base — Base's own chrome mounts a second language switcher meant only
// for the navbar-less anonymous pages, which would double-render alongside
// the navbar copy below), then wraps the page body in a responsive DaisyUI
// drawer: a persistent sidebar on lg+ screens, a hamburger-triggered
// slide-out on smaller ones. The sidebar menu is the owned ui.NavShell
// component so pages/agents never re-author nav markup.
//
// path is the current request path; it lights the active nav item (navItems(path)).
// The vehicle header slot is an htmx-swappable placeholder (#nav-header) served by
// GET /ui/nav-header — the shell paints identity-only immediately and the header
// swaps in after, keeping the telemetry+account reads off the critical render path.
templ BaseAuth(title, path string) {
	@baseShell(title, false) {
		<script>
			try {
				const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
				if (tz) document.cookie = "browser_tz=" + encodeURIComponent(tz) + ";path=/;max-age=31536000;SameSite=Lax";
			} catch (e) {}
		</script>
		<div class="drawer lg:drawer-open">
			<input id="nav-drawer" type="checkbox" class="drawer-toggle"/>
			<div class="drawer-content flex flex-col">
			<nav class="navbar bg-base-200 border-b border-base-300 w-full sticky top-0 z-40">
			<label for="nav-drawer" aria-label={ i18n.T(ctx, i18n.KeyNavOpenSidebar) } class="btn btn-square btn-ghost lg:hidden">
				@ui.Icon(ui.IconProps{Name: "menu", Class: "h-6 w-6"})
			</label>
			// Navbar title + vehicle context-switcher (htmx-swapped, authenticated-only
			// by virtue of living in BaseAuth). Served by GET /ui/vehicle-select; the
			// fragment renders the selected vehicle's name as the navbar title (replacing
			// the old fixed-brand text, falling back to the brand when no vehicle) AND
			// the <select> switcher for multi-vehicle accounts. Occupies the flex-1 brand
			// slot so it grows and pushes the language switcher to the right.
			<div id="vehicle-select" hx-get="/ui/vehicle-select" hx-trigger="load" hx-swap="outerHTML"></div>
			@ui.LangSwitcher(ui.LangSwitcherProps{Current: i18n.FromContext(ctx)})
			</nav>
				<main class="p-4">
					{ children... }
				</main>
			</div>
			// z-50 beats the navbar's z-40 (MAG-46 step 5). DaisyUI gives .drawer-side
			// z-index:10, and below `lg` the open drawer is a FIXED overlay starting at
			// top:0 while the navbar is `sticky top-0 z-40` — so the navbar painted over
			// the sidebar's first 4rem, swallowing the vehicle name, battery percentage
			// and range, and making the block appear to start at the progress bar.
			//
			// This is the real cause. Pushing the hidden content down with a margin-top
			// clears the symptom but leaves the sidebar underneath the navbar, so the
			// gap has to be re-tuned whenever the navbar's height changes and the
			// sidebar's top 4rem stay unclickable. Fixing the stacking order instead
			// needs no magic number.
			//
			// Harmless at `lg` and up: `lg:drawer-open` switches .drawer-side to
			// `position: sticky` in its own grid column, so the two never overlap there
			// and the z-index has nothing to win against.
			<div class="drawer-side z-50">
			<label for="nav-drawer" aria-label={ i18n.T(ctx, i18n.KeyNavCloseSidebar) } class="drawer-overlay"></label>
			// Flex column so the nav-header (auto) and the menu (flex-1) share the
			// sidebar's full height instead of stacking. The drawer-side grid aligns
			// items to its start; without this wrapper the menu's min-h-full would
			// push the footer logout BELOW the viewport and off-screen.
			// It also OWNS the sidebar surface (bg-base-200) and its edge against the
			// content (border-r): the nav-header and ui.NavShell inside it are
			// deliberately transparent, so the header, the menu and the navbar read as
			// ONE continuous chrome instead of three near-identical greys (MAG-44).
			<div class="flex flex-col h-full w-64 bg-base-200 border-r border-base-300">
			// placeholder: the nav-header fragment (GET /ui/nav-header) is swapped in by
			// htmx on load and re-fetched on the "vehicle-changed" event the vehicle
			// switcher (POST /ui/vehicle/select) fires, so the battery and range
			// reflect the newly-selected vehicle.
			<div id="nav-header" hx-get="/ui/nav-header" hx-trigger="load, vehicle-changed from:body" hx-swap="outerHTML"></div>
				@ui.NavShell(navItems(ctx, path), ui.NavLogout())
			</div>
		</div>
		</div>
	}
}