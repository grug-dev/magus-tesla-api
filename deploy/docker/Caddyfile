# Reverse proxy + automatic HTTPS for magus-tesla-api.
#
# BASE_DOMAIN comes from .env (compose passes it through env_file:). Caddy gets
# a Let's Encrypt certificate for this domain automatically, as long as its
# DNS A record points at this VPS and ports 80/443 are reachable.
#
# Edit here only if you are not using .env's BASE_DOMAIN — replace
# {$BASE_DOMAIN} with your literal domain, e.g. magus.example.com.
#
# /internal/rerun/* routes to the poller's manual-rerun listener
# (platform-add-manual-rerun-api, design.md D8); everything else keeps going
# to web:8080. Caddy forwards the whole subtree — it does not know the
# secret; poller's own handler accepts or 404s the exact path.
{$BASE_DOMAIN} {
	# Named, rotated access log. Caddy rotates this file itself, so it is kept
	# off the host logrotate conf - two rotators on one file lose data.
	# mode 0644 is REQUIRED, not cosmetic: caddy creates the file as its own
	# container user and defaults to 0600, which the host user cannot read even
	# when the folder is writable. 336h is 14 days, matching web.log/poller.log.
	log {
		output file /var/log/magus/caddy.log {
			mode 0644
			roll_size 10mb
			roll_keep 3
			roll_keep_for 336h
		}
	}
	handle /internal/rerun/* {
		reverse_proxy poller:8081
	}
	handle {
		reverse_proxy web:8080
	}
}

# Other sites that share this Caddy (today: jbh at jbh.usemagus.cloud, from the jbh-deploy repo).
# Each one drops a <name>.caddy file into the host folder CADDY_SITES_DIR, mounted read-only at
# /etc/caddy/sites. A glob, not a file path: a missing file would stop Caddy, an empty glob should
# only warn. Change those sites with `caddy validate` + `caddy reload`, never a restart — a bad
# file on restart stops Caddy, and Magus with it. See kkpa/docs/1-deploy/docker.md §13.
import /etc/caddy/sites/*.caddy
