  "decisions": [
    {
      "id": "D1",
      "at": "2026-08-05T14:50:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "Conflict rule is REPLACE - latest capture of a calendar day wins (ON CONFLICT DO UPDATE)",
      "why": "A re-run normally corrects a bad/partial nightly capture, so freshest data should survive",
      "covered_by": "grill-me interview, Step 2"
    },
    {
      "id": "D2",
      "at": "2026-08-05T14:52:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "captured_date DATE column computed in Go from the poller's *time.Location; UNIQUE (account_id, tesla_id, captured_date)",
      "why": "A UNIQUE index cannot depend on the runtime POLLER_TIMEZONE env var; expression indexes on UTC or a hardcoded zone were rejected",
      "covered_by": "grill-me interview, Step 2"
    },
    {
      "id": "D3",
      "at": "2026-08-05T14:54:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "Backfill dedupe keeps the latest captured_at; the older row of each pair is deleted",
      "why": "Consistent with D1 so historical and future rows share one semantic. 2 rows deleted (verified live).",
      "covered_by": "grill-me interview, Step 2"
    },
    {
      "id": "D4",
      "at": "2026-08-05T14:56:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "Scope is vehicle_snapshots only; poll_attempts stays append-only",
      "why": "poll_attempts records every attempt including failures/retries - the availability signal a daily collapse would destroy",
      "covered_by": "grill-me interview, Step 2"
    },
    {
      "id": "D5",
      "at": "2026-08-05T14:58:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "Reverse the append-only invariant (supersedes RM1 design D1), document the supersession, and add updated_at",
      "why": "The original rationale for omitting updated_at (never overwritten) no longer holds once rows can be replaced",
      "covered_by": "grill-me interview, Step 2"
    },
    {
      "id": "D6",
      "at": "2026-08-05T16:20:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "Database design gate CONFIRMED - schema, rationale and index plan approved as specified in design.md",
      "why": "Blocking gate per CLAUDE.md Design-Gates: database. Backfill timezone literal verified immaterial (0/44 rows differ between UTC and America/Bogota).",
      "covered_by": "design gate, Step 3"
    },
    {
      "id": "D7",
      "at": "2026-08-05T16:21:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "Pipeline stops at the proposal; Apply is deferred to a later resume",
      "why": "User asked for a proposal only and wants to review before implementation",
      "covered_by": "scope question, Step 3"
    }
  ],
