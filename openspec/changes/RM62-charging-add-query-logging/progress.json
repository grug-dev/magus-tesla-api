    },
    {
      "id": "D-L2",
      "at": "2026-09-17T10:23:44Z",
      "scope": "task:4.1",
      "made_by": "user",
      "decision": "A direct logging.Note in recalculate.go, not a second decorator in analytics",
      "why": "User chose one line over a new type plus a wiring change, after being shown both. Cost: the only RM62 log line outside a query_log.go.",
      "covered_by": null
    },
