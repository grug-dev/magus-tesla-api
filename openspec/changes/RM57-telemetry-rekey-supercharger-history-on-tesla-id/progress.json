  "decisions": [
    {
      "id": "RD6",
      "scope": "database",
      "made_by": "user",
      "at": "2026-09-13T02:12:00Z",
      "what": "Index plan approved: vehicle_time and account_updated re-keyed on tesla_id, account_time dropped with no replacement.",
      "why": "account_time's only reader was SuperchargerHistoryByAccount, removed here. The new (tesla_id, updated_at) index also removes a sort the mirror read pays today."
    },
    {
      "id": "RD7",
      "scope": "integration",
      "made_by": "user",
      "at": "2026-09-13T02:12:00Z",
      "what": "processor.go fans out over each account's vehicles now, keeping the account-keyed watermark.",
      "why": "The account-wide read cannot survive the column drop and has a production caller. The fan-out uses a port that already exists, so tier 3 undoes nothing."
    },
    {
      "id": "RD8",
      "scope": "ports",
      "made_by": "autopilot",
      "at": "2026-09-13T02:12:00Z",
      "what": "SuperchargerHistoryByAccount and SuperchargerHistoryByAccountUpdatedSince are removed, not re-keyed.",
      "why": "Both filter on account_id alone. Dropping the parameter would leave a whole-table scan."
    }
  ],
