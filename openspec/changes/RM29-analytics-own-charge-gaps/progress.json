  "decisions": [
    {
      "id": "I1",
      "at": "2026-08-22T02:42:00Z",
      "made_by": "user",
      "scope": "design",
      "decision": "git mv the charge_gaps migration file into analytics dir; no new migration, no DDL, no data copy.",
      "why": "goose keys applied-ness by version in one shared table across dirs, so neither dir re-runs it. The DROP+CREATE shape would lose the data, since MIGRATIONS_DIRS runs telemetry before analytics."
    },
    {
      "id": "I2",
      "at": "2026-08-22T02:43:00Z",
      "made_by": "user",
      "scope": "design",
      "decision": "The GapWriter port moves as-is to analytics; cmd/poller keeps its two-step shape. Collapsing into Recalculate was rejected.",
      "why": "Keeps the tier a pure ownership move. The metrics/gaps divergence on a step-2 error is pre-existing and deliberately untouched, documented so the reviewer does not read it as a regression."
    },
    {
      "id": "I3",
      "at": "2026-08-22T02:44:00Z",
      "made_by": "user",
      "scope": "design",
      "decision": "MissingChargingType moves to analytics; gateway history.go re-points its import.",
      "why": "The enum follows the data. telemetry ends with zero references; analytics stops importing telemetry for a label about its own data."
    },
    {
      "id": "A1",
      "at": "2026-08-22T02:55:00Z",
      "made_by": "autopilot",
      "scope": "gate",
      "decision": "Treated the database design gate as SATISFIED by the owner interview rather than re-asking.",
      "why": "The owner confirmed I1-I3 directly before artifacts existed, and design.md declares no DDL - verified: sqlc.yaml scopes schema per module dir, so the atomic-move constraint is real."
    },
    {
      "id": "A2",
      "at": "2026-08-22T02:55:00Z",
      "made_by": "autopilot",
      "scope": "process",
      "decision": "Leader ran git add -A while a worker was writing, sweeping draft T5 artifacts into the suite-run commit; amended the message to say so rather than rewriting history.",
      "why": "Nothing lost, branch unpushed. A commit that misdescribes its own contents is worse than an untidy one. Staging explicit paths from here."
    }
