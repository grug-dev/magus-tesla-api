  "decisions": [
    {
      "id": "D1",
      "at": "2026-08-21T03:05:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "IO-1 grain/PK: vehicle-day, UUID PK + UNIQUE(account_id,tesla_id,metric_date)",
      "why": "Matches vehicle_snapshots' deduped daily grain and charge_gaps' precedent. A per-snapshot FK into telemetry was rejected as a module-boundary violation.",
      "covered_by": "grill-me interview 2026-08-21 + design gate"
    },
    {
      "id": "D2",
      "at": "2026-08-21T03:05:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "IO-2 watermark in a dedicated cursor table, not a column on vehicle_metrics",
      "why": "Survives the zero-rows first run; MAX() over the metrics table would silently rewind when a row is recomputed away.",
      "covered_by": "grill-me interview 2026-08-21 + design gate"
    },
    {
      "id": "D3",
      "at": "2026-08-21T03:05:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "IO-3 one cursor row per (vehicle, source), three sources",
      "why": "manual_charge_entries is user-edited at any hour while the other two move at midnight; one shared cursor couples those clocks.",
      "covered_by": "grill-me interview 2026-08-21 + design gate"
    },
    {
      "id": "D4",
      "at": "2026-08-21T03:05:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "IO-4 commit-skew guard: 24h safety overlap on the cursor read",
      "why": "Without it a user edit landing mid-run is skipped permanently and silently. UPSERT is idempotent so re-reads are free.",
      "covered_by": "grill-me interview 2026-08-21 + design gate"
    },
    {
      "id": "D5",
      "at": "2026-08-21T03:05:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "IO-5 Recalculate after the manual-charge write",
      "why": "That chart updates instantly today; precomputing without this ships a user-visible regression against D10's characterization bar.",
      "covered_by": "grill-me interview 2026-08-21 + design gate"
    },
    {
      "id": "D6",
      "at": "2026-08-21T03:05:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "IO-6 only snapshot-derived math leaves the gateway; Supercharger tiles defer to T6",
      "why": "T6 moves those session rows to charging anyway - doing them here writes the same code twice.",
      "covered_by": "grill-me interview 2026-08-21 + design gate"
    },
    {
      "id": "D7",
      "at": "2026-08-21T03:05:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "Design gate: schema approved with one revision - dense table, nullable _calc + consumed_pct",
      "why": "Sparse rows meant a vehicle's first day had no row, so re-pointing the battery chart later would silently drop day 1.",
      "covered_by": "grill-me interview 2026-08-21 + design gate"
    },
    {
      "id": "D8",
      "at": "2026-08-21T03:05:00Z",
      "scope": "change",
      "made_by": "leader",
      "decision": "consumed_pct nullable with flagged=false on predecessor-less rows; both Reader queries filter IS NOT NULL",
      "why": "Necessary consequence of the owner's dense-table call: a stored 0 would make every vehicle's first day masquerade as a charge gap, and unfiltered reads would change ConsumedByDay's output.",
      "covered_by": "design gate revision"
    },
    {
      "id": "D9",
      "at": "2026-08-21T09:20:00Z",
