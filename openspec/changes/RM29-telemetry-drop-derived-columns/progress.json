  "decisions": [
    {
      "id": "I1",
      "at": "2026-08-21T21:40:00Z",
      "made_by": "user",
      "scope": "design",
      "decision": "The five _calc derivations move into analytics; telemetry loses the columns, deriveConsumption, and the five Snapshot port fields.",
      "why": "Rejected computing-on-read in telemetry: it leaves telemetry owning a derivation whose only consumer is another module, and taxes every read forever."
    },
    {
      "id": "I2",
      "at": "2026-08-21T21:45:00Z",
      "made_by": "user",
      "scope": "design",
      "decision": "Analytics gets the exact predecessor via a new telemetry port method SnapshotPrecedingDay, not a widened fixed lookback.",
      "why": "A gap longer than any fixed N yields a silently wrong delta that looks plausible on a chart, so nothing would ever flag it."
    },
    {
      "id": "I3",
      "at": "2026-08-21T21:50:00Z",
      "made_by": "user",
      "scope": "design",
      "decision": "Existing vehicle_metrics rows are rebuilt by deleting the vehicle_snapshots watermark in a migration; the next Reconcile backfills.",
      "why": "Reuses machinery tier 3 already built and the owner exercised. Avoids a second throwaway runner, which last time swept a 15MB binary into the repo."
    },
    {
      "id": "I4",
      "at": "2026-08-21T21:52:00Z",
      "made_by": "user",
      "scope": "design",
      "decision": "The change spans telemetry and analytics and needs two migrations, one per module; no sub-task edits both modules.",
      "why": "A telemetry migration must never write analytics' table. Preserves module data ownership while the derivation moves."
    },
    {
      "id": "A1",
      "at": "2026-08-21T22:00:00Z",
      "made_by": "autopilot",
      "scope": "scope",
      "decision": "Pulled the pre-existing SnapshotsByVehicleBetween LIMIT 400 truncation bug into this tier as task 4.9 (raise to 4000), against the worker's out-of-scope call.",
      "why": "I3 deliberately re-runs the full-history path that trips it, and truncation is silent while the watermark still advances. Re-arming a known silent-corruption bug is not minimal scope."
    },
    {
      "id": "A2",
      "at": "2026-08-21T22:00:00Z",
      "made_by": "autopilot",
