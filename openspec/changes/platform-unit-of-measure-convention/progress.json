  "decisions": [
    {
      "id": "D1",
      "at": "2026-08-07T15:13:30Z",
      "scope": "design-gate",
      "made_by": "leader",
      "decision": "The always-on `database` design gate does NOT fire for this change, and no grill-me pass was run.",
      "why": "The change is docs + spec only - zero migrations, zero schema objects, zero Go changes (tasks.md header and task 5.6 both assert it, and 5.6 gates on `git diff --stat` touching only .md). There is also no competing design to grill: the artifacts were authored and validated earlier, and RM7 already settled the underlying rule with the user across decisions RD1-RD12.",
      "covered_by": null
    },
    {
      "id": "D2",
      "at": "2026-08-07T15:13:30Z",
      "scope": "scoping",
      "made_by": "leader",
      "decision": "Dispatch ONE worker identified as `platform` with explicitly granted paths, rather than a module-sandboxed worker or four per-module workers.",
      "why": "There is no `internal/platform` module - openspec/config.yaml designates `platform-` for cross-cutting changes. The file set spans two repo-root docs plus four modules' AGENTS.md, so no single Modules-Root child owns it. SKILL Step 0 allows a sandbox of 'one child of this folder PLUS explicitly granted paths'. Four per-module workers would each re-read the doc pack and, per task 4.5, are the drift risk the change exists to prevent; one coherent pass keeps the five copies consistent.",
      "covered_by": null
    },
    {
      "id": "D3",
      "at": "2026-08-07T15:13:30Z",
      "scope": "staleness",
      "made_by": "leader",
      "decision": "Tasks 5.1 and 5.2 are OBSOLETE and will be marked blocked, not executed and not deleted.",
      "why": "Both were written before RM7 ran. 5.1 says to remove tasks 6.2/6.3 from openspec/changes/telemetry-store-display-units/tasks.md - that change is now ARCHIVED at openspec/changes/archive/telemetry/2026-08-07-... with 6.1-6.3 all ticked; editing an archived artifact would falsify the historical record. 5.2's substance was already done during RM7: RD12 was amended in-flight ('Amended 2026-08-06') with covered_by set to this change. Task text is append-only so it stays verbatim; the obsolescence is recorded here.",
      "covered_by": null
    },
    {
      "id": "D4",
      "at": "2026-08-07T15:13:30Z",
      "scope": "gate",
      "made_by": "leader",
      "decision": "Task 5.3's precondition is SATISFIED - this change may now be archived.",
      "why": "5.3 forbids archiving until RM7 tier 4 is archived, so the merged unit-of-measure spec never asserts a compliance the code has not reached. RM7 tier 4 (gateway-adopt-snapshot-unit-fields) was archived earlier today and the whole roadmap is archived, so vehicle_snapshots now genuinely stores km/C/PSI.",
      "covered_by": null
    }
  ],
