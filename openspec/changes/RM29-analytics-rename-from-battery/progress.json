  "decisions": [
    {
      "id": "D1",
      "at": "2026-08-20T17:15:32Z",
      "scope": "change",
      "made_by": "leader",
      "decision": "Delta spec uses MODIFIED against a git-mv'd specs folder, not ADDED+REMOVED",
      "why": "The ADDED path makes the archiver synthesize a TBD Purpose and orphan an empty battery/ husk. MODIFIED keeps the hand-written Purpose; cost is one hard-ordered task (3.1).",
      "covered_by": null
    },
    {
      "id": "D2",
      "at": "2026-08-20T17:15:32Z",
      "scope": "change",
      "made_by": "leader",
      "decision": "Wave-1 file moves use plain mv, not git mv; the leader stages",
      "why": "tasks.md told the module worker to run git mv, which write-ownership forbids. Git stores no renames, so mv + git add -A yields an identical commit and blame.",
      "covered_by": null
    },
    {
      "id": "D3",
      "at": "2026-08-20T17:15:32Z",
      "scope": "task:2.6",
      "made_by": "leader",
      "decision": "Accepted the worker's rename of 3 stale identifiers in history_test.go not named in the proposal",
      "why": "The file is compile-forced open anyway; leaving fakeBatteryReader et al. stale recreates the duplicate-vocabulary cost RM29 exists to remove. Names only, no assertion change.",
      "covered_by": "roadmap D3"
    }
  ],
