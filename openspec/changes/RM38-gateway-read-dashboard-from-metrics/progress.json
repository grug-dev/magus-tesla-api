  "decisions": [
    {
      "id": "D8",
      "at": "2026-09-01T17:20:00Z",
      "scope": "change",
      "made_by": "user",
      "decision": "Gateway keeps VehicleStatus.CapturedAt as the time source; metric_date is NOT added to the analytics port; the 36h/48h thresholds are unchanged",
      "why": "The metric_date option needs a new analytics tier plus a +24h retune of both thresholds. The owner accepts a NULL captured_at instead",
      "covered_by": "roadmap D8"
    },
    {
      "id": "D9",
      "at": "2026-09-01T17:20:30Z",
      "scope": "change",
      "made_by": "leader",
      "decision": "NULL CapturedAt renders no date and no [Stale] badge on the dashboard, and Asleep with no last-seen label in the nav header",
      "why": "Connected needs a timestamp to prove freshness. Affects at most one nightly cycle after deploy, then self-heals",
      "covered_by": "roadmap D9"
    }
  ],
