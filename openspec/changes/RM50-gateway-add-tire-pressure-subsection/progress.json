  "decisions": [
    {
      "id": "D-zero-delta",
      "at": "2026-09-09T08:45:24Z",
      "scope": "ui",
      "made_by": "user",
      "decision": "A real 0.0 tyre delta renders NO icon but still prints its numeric line ('0.0 vs prev. day'). A nil delta prints no line at all. No third neutral glyph is added.",
      "why": "User picked it from three options. The numeric line already tells 'no change' apart from 'unknown', so a new glyph in the shared ui/ kit is not worth the blast radius."
    },
    {
      "id": "D-no-db",
      "at": "2026-09-09T08:45:24Z",
      "scope": "database",
      "made_by": "leader",
      "decision": "Tier 4 touches no database object, so the built-in database design gate does not apply. It reads the same precomputed row tier 3 already widened.",
      "why": "The gate exists for schema changes. Recording the check so a reviewer sees it was made, not skipped."
    }
