# Tesla Fleet API credentials — from developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# Obtained by running: go run ./cmd/setup
TESLA_ACCESS_TOKEN=
TESLA_REFRESH_TOKEN=

# PostgreSQL DSN for the account module store. Read by the app AND by the
# Makefile (`make db-setup` derives the DB name + bootstrap admin connection from it).
#
# START with this user-less "bootstrap" value: with no user:pass, the Makefile's
# admin connection falls back to your OS superuser (the Homebrew role) to CREATE
# the login role + database. The DB need not exist yet — `make db-setup` creates
# the role (prompting for a password), the database (owned by that role), migrates,
# then PRINTS the final DSN to paste back here, e.g.:
#   DATABASE_URL=postgres://magusadmindb:<password>@localhost:5432/magus?sslmode=disable
# (percent-encode the password if it contains any of  @ : / ? # % )
#
# For a Docker Compose deploy (see kkpa/docs/1-deploy/docker.md), use the "db"
# service hostname instead of localhost, and match POSTGRES_USER/PASSWORD/DB
# below, e.g.:
#   DATABASE_URL=postgres://magus:CHANGE_ME@db:5432/magus?sslmode=disable
DATABASE_URL=postgres://localhost:5432/magus?sslmode=disable

# OPTIONAL — only for non-interactive setup (CI/prod, where `make db-setup` cannot
# prompt). If the app role is missing, its password is taken from here instead of a
# prompt. Leave empty for local interactive setup. Never commit a real value.
# This is a DIFFERENT secret from POSTGRES_PASSWORD below: MAGUS_DB_PASSWORD is
# only for `make db-setup`'s host-only role bootstrap; the app itself never
# reads it.
MAGUS_DB_PASSWORD=

# --- Docker Compose only (compose-local PostgreSQL provisioning) ------------
# These three variables are read ONLY by the official postgres image, on the
# first boot of an empty "db" service volume — they create its role and
# database. The app itself never reads them; it reads DATABASE_URL above.
# Never reuse MAGUS_DB_PASSWORD's value here — they are different secrets for
# different roles (host-only bootstrap vs. the compose-local database).
POSTGRES_USER=magus
POSTGRES_PASSWORD=
POSTGRES_DB=magus

# Public domain Caddy issues an HTTPS certificate for (Docker Compose deploy
# only). Must have a DNS A record pointing at the VPS. See
# kkpa/docs/0-set-up/deployment.md §8.
BASE_DOMAIN=

# Host folder bind-mounted into web, poller, and caddy for named log files
# (Docker Compose deploy only). See kkpa/docs/1-deploy/docker.md.
MAGUS_LOGS_DIR=/home/magus/magus-logs

# --- Docker Compose only (per-service CPU and memory limits) ---------------
# Every service in deploy/docker/compose.yaml has a CPU and a memory limit, so
# one runaway container cannot starve the others. The defaults below assume a
# small VPS: 4 GB RAM and 2 vCPU. They are already applied by compose.yaml —
# leave every line COMMENTED unless you run different hardware. Uncommenting a
# line overrides the default for that one service.
#
# cpus is a fraction of one core ("0.5" = half a core). memory takes a suffix
# ("256M", "1536M", "2G"). A container that passes its memory limit is killed
# by the kernel, so raise the limit rather than removing it.
#
# db — PostgreSQL. Gets the largest share: it holds the shared buffers and does
# every query the web gateway and the poller run.
#DB_CPU_LIMIT=1.0
#DB_MEM_LIMIT=1536M
#
# migrate — runs the migrations once, then exits. Short-lived, but reads four
# migration directories, so it is not the smallest.
#MIGRATE_CPU_LIMIT=0.5
#MIGRATE_MEM_LIMIT=256M
#
# web — the HTTP gateway. Serves the dashboard and the embedded static assets.
#WEB_CPU_LIMIT=0.5
#WEB_MEM_LIMIT=256M
#
# poller — the nightly telemetry collector. Idle nearly all day, so it gets the
# smallest share.
#POLLER_CPU_LIMIT=0.25
#POLLER_MEM_LIMIT=128M
#
# poller — manual-rerun HTTP endpoint. POST /internal/rerun/<POLLER_RERUN_TOKEN>
# starts one on-demand vehicle-data cycle. Leave EMPTY to disable the endpoint
# entirely — no port opens, no route exists. Generate a value with:
#   openssl rand -hex 16
# Any random string works; it only needs to be hard to guess. Rotating it is a
# plain .env edit plus a container restart (docker compose up -d) — no rebuild.
POLLER_RERUN_TOKEN=
#
# caddy — the reverse proxy. Forwards requests and renews the certificate.
#CADDY_CPU_LIMIT=0.25
#CADDY_MEM_LIMIT=128M

# Web gateway (cmd/web)
PORT=8080
# Strong, STABLE secret keying the signed+encrypted session cookie.
# Generate with: openssl rand -hex 32   (rotating it logs every user out)
SESSION_SECRET=
# Public base URL of the app. Two jobs:
#   1. builds the Google OAuth redirect URI (BASE_URL + /auth/google/callback)
#   2. makes the SEO / link-preview tags absolute (canonical, og:url, og:image)
# Set it to your https domain in production. If you leave the localhost default
# there, every shared link preview will point at localhost:8080.
BASE_URL=http://localhost:8080

# Google OAuth (user login) — from Google Cloud Console → Credentials → OAuth client ID.
# Add the redirect URI  <BASE_URL>/auth/google/callback  to the client's authorized list.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
