# Tesla Fleet API credentials — from developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

TESLA_REFRESH_TOKEN=

# PostgreSQL DSN for the account module store. Read by the app AND by the
# Makefile (`make db-setup` derives the DB name + bootstrap admin connection from it).
#
# START with this user-less "bootstrap" value: with no user:pass, the Makefile's
# admin connection falls back to your OS superuser (the Homebrew role) to CREATE
# the login role + database. The DB need not exist yet — `make db-setup` creates
# the role (prompting for a password), the database (owned by that role), migrates,
# then PRINTS the final DSN to paste back here, e.g.:
#   DATABASE_URL=postgres://magusadmindb:<password>@localhost:5432/magus?sslmode=disable
# (percent-encode the password if it contains any of  @ : / ? # % )
DATABASE_URL=postgres://localhost:5432/magus?sslmode=disable

# OPTIONAL — only for non-interactive setup (CI/prod, where `make db-setup` cannot
# prompt). If the app role is missing, its password is taken from here instead of a
# prompt. Leave empty for local interactive setup. Never commit a real value.
MAGUS_DB_PASSWORD=

# Web gateway (cmd/web)
PORT=8080
# Strong, STABLE secret keying the signed+encrypted session cookie.
# Generate with: openssl rand -hex 32   (rotating it logs every user out)
SESSION_SECRET=
# Public base URL of the app — used to build the Google OAuth redirect URI
# (BASE_URL + /auth/google/callback). Set to your https domain in production.
BASE_URL=http://localhost:8080

# Google OAuth (user login) — from Google Cloud Console → Credentials → OAuth client ID.
# Add the redirect URI  <BASE_URL>/auth/google/callback  to the client's authorized list.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
