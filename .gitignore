.env
*.pem
!magus-public-key-netlify/**/*.pem
private-key*
.DS_Store
*.zip
.idea

# Database dumps written by deploy/docker/backup-db.sh (make backup-db) on the
# VPS. They contain every row in the database — tokens, vehicle GPS, user rows.
# The script writes them inside the repo, so without this line they show up as
# untracked and a `git add -A` could commit them.
backups/

# Local Netlify folder
.netlify

# Raw Tesla Fleet API payloads captured by cmd/explore-tesla-api. Contain sensitive
# data (VIN, GPS lat/lng, energy_site_id, Wall Connector DIN/serial) — never commit.
cmd/explore-tesla-api/output/

bin/

# Delve debug binaries, one per debug session, ~17 MB each. The VS Code launch
# entries drop them beside the package being debugged, so no single folder rule
# catches them.
__debug_bin*

# Air (live-reload) build outputs and log — created by `make dev`.
tmp/
.air/

# Node-less Tailwind CLI binary for the gateway UI. Platform-specific and large
# (~80 MB), re-fetchable with `make ui-toolchain`. Only this native binary is ignored:
# the DaisyUI .mjs bundles, input.css, and the generated app.css under
# internal/gateway/static/ ARE committed (app.css is a vendored artifact like htmx.min.js,
# so `go build ./...` and the //go:embed static stay self-contained with no pre-step).
internal/gateway/tools/tailwindcss

# Compiled cmd binaries built at the repo root by `go build ./cmd/<name>`
# (without -o). Use `make bins` instead — it outputs to bin/ above. These
# entries catch accidental root-level builds so they never get committed.
/explore-tesla-api
/migrate
/monthly-capacity
/poller
/setup
/web
# Throwaway one-off runners the pipeline builds at the repo root (cmd/tmp-*),
# e.g. a one-time backfill. The source is deleted after the run; this catches
# the compiled artifact so a 15 MB binary can never ride along in a commit.
/tmp-*
