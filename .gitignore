.env
*.pem
!magus-public-key-netlify/**/*.pem
private-key*
.DS_Store
*.zip

# Local Netlify folder
.netlify

# Raw Tesla Fleet API payloads captured by cmd/explore-tesla-api. Contain sensitive
# data (VIN, GPS lat/lng, energy_site_id, Wall Connector DIN/serial) — never commit.
cmd/explore-tesla-api/output/

bin/

# Compiled cmd binaries built at the repo root by `go build ./cmd/<name>`
# (without -o). Use `make bins` instead — it outputs to bin/ above. These
# entries catch accidental root-level builds so they never get committed.
/explore-tesla-api
/poller
/setup
/web
